Перем _Задержка; // Число

// Создает сервис, который отвечает с искусственной задержкой.
//
// Параметры:
//   Задержка - Число - Время ожидания перед ответом в миллисекундах.
Процедура ПриСозданииОбъекта(Задержка = 300)
	_Задержка = Задержка;
КонецПроцедуры

// Возвращает данные после заданной задержки.
//
// Возвращаемое значение:
//   Строка - Сообщение с длительностью ожидания.
Функция ПолучитьДанные() Экспорт

	Приостановить(_Задержка);
	Возврат СтрШаблон("Данные получены за %1 мс", _Задержка);

КонецФункции
