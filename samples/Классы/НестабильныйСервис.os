Перем _Счетчик; // Число
Перем _КоличествоСбоевДоУспеха; // Число

// Создает сервис, который сначала падает, а затем начинает отвечать успешно.
//
// Параметры:
//   КоличествоСбоевДоУспеха - Число - Сколько первых вызовов завершить ошибкой.
Процедура ПриСозданииОбъекта(КоличествоСбоевДоУспеха = 0)
	_Счетчик = 0;
	_КоличествоСбоевДоУспеха = КоличествоСбоевДоУспеха;
КонецПроцедуры

// Возвращает данные или выбрасывает временную ошибку до достижения успешной попытки.
//
// Возвращаемое значение:
//   Строка - Сообщение с номером успешной попытки.
Функция ПолучитьДанные() Экспорт

	_Счетчик = _Счетчик + 1;

	Если _Счетчик <= _КоличествоСбоевДоУспеха Тогда
		ВызватьИсключение "Временный сбой сервиса.";
	КонецЕсли;

	Возврат СтрШаблон("Данные получены на попытке %1", _Счетчик);

КонецФункции
