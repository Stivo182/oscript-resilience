Перем _ОсталосьОтветовНеГотово; // Число
Перем _Счетчик; // Число

// Создает сервис, который несколько раз отвечает "НЕ ГОТОВО", а затем возвращает успех.
//
// Параметры:
//   КоличествоОтветовНеГотово - Число - Сколько первых проверок вернуть как неготовые.
Процедура ПриСозданииОбъекта(КоличествоОтветовНеГотово = 0)

	_ОсталосьОтветовНеГотово = КоличествоОтветовНеГотово;
	_Счетчик = 0;

КонецПроцедуры

// Проверяет готовность и возвращает промежуточный или успешный результат.
//
// Возвращаемое значение:
//   Строка - "НЕ ГОТОВО" или сообщение с номером успешной попытки.
Функция ПроверитьГотовность() Экспорт

	_Счетчик = _Счетчик + 1;

	Если _ОсталосьОтветовНеГотово > 0 Тогда
		_ОсталосьОтветовНеГотово = _ОсталосьОтветовНеГотово - 1;
		Возврат "НЕ ГОТОВО";
	КонецЕсли;

	Возврат СтрШаблон("ГОТОВО на попытке %1", _Счетчик);

КонецФункции
