#Использовать ".."
#Использовать "."

// Пример показывает операцию, результат которой нужен не сразу.
// Пайплайн запускает ее в фоне, а вызывающий код забирает результат из обещания позже.

// Настройка
Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьПовтор(1, 50);

// Запуск
УспешноеОбещание = Пайплайн.ЗапуститьАсинх(
	"(Имя) -> Возврат СтрШаблон(""Привет, %1!"", Имя)",
	"Мир"
);

// Выведет: Успешный результат: Привет, Мир!
Сообщить("Успешный результат: " + Строка(УспешноеОбещание.Получить()));
