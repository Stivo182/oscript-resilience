#Использовать ".."
#Использовать "."

// Пример показывает фоновый запрос к нестабильному сервису.
// Если повтор не помогает, ошибка превращается в понятный результат через Поймать().

// Подготовка
Сервис = Новый НестабильныйСервис(2);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьПовтор(1, 50);

// Запуск
ОбещаниеСОшибкой = Пайплайн.ЗапуститьАсинх(Операция);

ОбработанноеОбещание = ОбещаниеСОшибкой.Поймать(
	"(ИнформацияОбОшибке) -> КраткоеПредставлениеОшибки(ИнформацияОбОшибке)"
);

// Выведет: Обработанный результат: Временный сбой сервиса.
Сообщить("Обработанный результат: " + Строка(ОбработанноеОбещание.Получить()));
