#Использовать ".."
#Использовать "."

// Пример показывает собственное правило обработки результата.
// Пользовательская стратегия добавляет префикс к ответу операции.

// Настройка
Стратегия = Новый ПрефикснаяСтратегия("Кастомная стратегия: ");

Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьСтратегию(Стратегия);

// Запуск
Результат = Пайплайн.Запустить(
	"(Имя) -> Возврат СтрШаблон(""Привет, %1!"", Имя)",
	"Мир"
);

// Выведет: Кастомная стратегия: Привет, Мир!
Сообщить(Результат);
