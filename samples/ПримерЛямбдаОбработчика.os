#Использовать ".."
#Использовать "."

// Пример показывает нестабильный сервис, для которого нужен резервный ответ.
// Обработчик запасного сценария задан лямбда-выражением прямо при настройке пайплайна.

// Подготовка
Сервис = Новый НестабильныйСервис(2);
РезервныйРезультат = "Резервный результат";

// Настройка
Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьЗапаснойСценарий(
		"(КонтекстОшибки, Результат) -> Возврат Результат",
		РезервныйРезультат
	)
	.ДобавитьПовтор(1, 50);

// Запуск
Результат = Пайплайн.Запустить(
	"(Сервис) -> Возврат Сервис.ПолучитьДанные()",
	Сервис
);

// Выведет: Результат запасного сценария: Резервный результат
Сообщить("Результат запасного сценария: " + Строка(Результат));
