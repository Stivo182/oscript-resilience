#Использовать ".."
#Использовать "."

// Пример показывает быстрый вызов нестабильного сервиса без отдельного класса операции.
// Операция задана лямбда-выражением, а пайплайн повторяет вызов после первого сбоя.

// Подготовка
Сервис = Новый НестабильныйСервис(1);

// Настройка
Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьПовтор(1, 50);

// Запуск
Результат = Пайплайн.Запустить(
	"(Сервис) -> Возврат Сервис.ПолучитьДанные()",
	Сервис
);

// Выведет: Результат операции-лямбды: Данные получены на попытке 2
Сообщить("Результат операции-лямбды: " + Строка(Результат));
