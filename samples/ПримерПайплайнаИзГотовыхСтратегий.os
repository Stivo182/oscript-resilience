#Использовать ".."
#Использовать "."

// Пример показывает сервис с временными сбоями.
// Стратегии настраиваются отдельно, а затем собираются в один пайплайн.

// Подготовка
Сервис = Новый НестабильныйСервис(2);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка стратегий по отдельности удобна, когда их нужно переиспользовать
// или хранить отдельно от сборки пайплайна.

// Настройка
Повтор = Новый СтратегияПовтора()
	.УстановитьМаксимумПовторов(3)
	.УстановитьЗадержку(50);

Предохранитель = Новый СтратегияПредохранителя()
	.УстановитьПорогОшибок(3)
	.УстановитьДлительностьРазмыкания(500);

Таймаут = Новый СтратегияТаймаута(1000);

ЗапаснойСценарий = Новый СтратегияЗапасногоСценария(
	"(КонтекстОшибки) -> Возврат ""Резервный результат"""
);

// Порядок важен: ЗапаснойСценарий оборачивает всю цепочку,
// а Таймаут находится ближе всего к операции.
Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьСтратегию(ЗапаснойСценарий)
	.ДобавитьСтратегию(Повтор)
	.ДобавитьСтратегию(Предохранитель)
	.ДобавитьСтратегию(Таймаут);

// Запуск
Результат = Пайплайн.Запустить(Операция);

// Выведет: Результат: Данные получены на попытке 3
Сообщить("Результат: " + Строка(Результат));
