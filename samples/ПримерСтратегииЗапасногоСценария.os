#Использовать ".."
#Использовать "."

// Пример показывает сервис, который недоступен дольше допустимого.
// Вместо ошибки наружу стратегия возвращает заранее подготовленный резервный результат.

Функция ПолучитьРезервныйРезультат() Экспорт
	Возврат "Резервный результат";
КонецФункции

// Подготовка
Сервис = Новый НестабильныйСервис(5);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
Пайплайн = Новый ПайплайнОтказоустойчивости();
Пайплайн.ДобавитьЗапаснойСценарий(
	"(Контекст, Сервис) -> Возврат Сервис.ПолучитьРезервныйРезультат()",
	ЭтотОбъект
);

// Запуск
Результат = Пайплайн.Запустить(Операция);

// Выведет: Результат: Резервный результат
Сообщить("Результат: " + Строка(Результат));
