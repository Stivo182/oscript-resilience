#Использовать ".."
#Использовать "."

// Пример показывает резервный ответ только для ожидаемых временных сбоев.
// Если ошибка не подходит под условие, запасной сценарий не сработает.

// Условие запасного сценария
Функция ОшибкаСодержит(КонтекстОшибки, ФрагментОшибки) Экспорт

	ТекстОшибки = КраткоеПредставлениеОшибки(КонтекстОшибки.ДанныеОшибки());
	Возврат СтрНайти(ТекстОшибки, ФрагментОшибки) > 0;

КонецФункции

Функция ПолучитьРезервныйРезультат() Экспорт
	Возврат "Резервный результат";
КонецФункции

// Подготовка
Сервис = Новый НестабильныйСервис(1);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
Стратегия = Новый СтратегияЗапасногоСценария();
Стратегия.УстановитьОбработчик(
	"(Контекст, Сервис) -> Возврат Сервис.ПолучитьРезервныйРезультат()",
	ЭтотОбъект
);
Стратегия.УстановитьУсловиеЗапасногоСценария(
	Новый Действие(ЭтотОбъект, "ОшибкаСодержит"),
	"Временный сбой"
);

// Запуск
Результат = Стратегия.Применить(Операция);

// Выведет: Результат: Резервный результат
Сообщить("Результат: " + Строка(Результат));
