#Использовать ".."
#Использовать "."

// Пример показывает внешний сервис, который принимает запросы с ограниченной частотой.
// Стратегия равномерно распределяет вызовы и ждет ближайшее разрешение.

// Подготовка
Сервис = Новый НестабильныйСервис();
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
// Например, внешний сервис принимает не больше двух запросов в секунду.
// В режиме равномерного распределения стратегия отправляет запросы не пачкой,
// а примерно через равные промежутки времени. Если ближайшее разрешение скоро,
// вызов подождет его вместо немедленного отказа.
Стратегия = Новый СтратегияОграниченияВызовов(2, 1000)
	.УстановитьТипОграничения(ТипыОграниченияВызовов.РавномерноеРаспределение)
	.УстановитьМаксимальноеОжиданиеРазрешения(700);

// Запуск
// Выведет четыре успешных запроса: попытки 1, 2, 3 и 4.
Для НомерЗапроса = 1 По 4 Цикл
	Результат = Стратегия.Применить(Операция);
	// Выведет строку вида: Запрос <номер>: Данные получены на попытке <номер>
	Сообщить(СтрШаблон("Запрос %1: %2", НомерЗапроса, Результат));
КонецЦикла;
