#Использовать ".."
#Использовать "."

// Пример показывает обработчик фоновых задач с одним рабочим слотом
// и одной задачей в очереди. Лишняя задача отклоняется сразу.

// Служебные ожидания нужны только для асинхронного примера: они дожидаются,
// пока фоновая задача действительно займет слот или попадет в очередь.

Процедура ДождатьсяКоличествоВыполняющихся(Стратегия, Количество)

	Для НомерПопытки = 1 По 50 Цикл
		Если Стратегия.КоличествоВыполняющихся() = Количество Тогда
			Возврат;
		КонецЕсли;

		Приостановить(10);
	КонецЦикла;

	ВызватьИсключение "Не удалось дождаться нужного количества выполняющихся задач.";

КонецПроцедуры

Процедура ДождатьсяКоличествоОжидающих(Стратегия, Количество)

	Для НомерПопытки = 1 По 50 Цикл
		Если Стратегия.КоличествоОжидающих() = Количество Тогда
			Возврат;
		КонецЕсли;

		Приостановить(10);
	КонецЦикла;

	ВызватьИсключение "Не удалось дождаться нужного количества ожидающих задач.";

КонецПроцедуры

// Подготовка
Сервис = Новый МедленныйСервис(300);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Для ограничения параллелизма нужны одновременно выполняющиеся задачи,
// поэтому в примере используется пайплайн и асинхронный запуск.

// Настройка
Стратегия = Новый СтратегияОграниченияПараллелизма(1, 1);
// При переполнении обработчик выведет: Слот и очередь заняты, лишняя задача отклонена.
Стратегия.УстановитьОбработчикПереполнения(
	"(КонтекстПереполнения) -> Сообщить(""Слот и очередь заняты, лишняя задача отклонена."")"
);

Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьСтратегию(Стратегия);

// Запуск
// Первая задача запускается асинхронно и занимает единственный слот.
ПервыйВызов = Пайплайн.ЗапуститьАсинх(Операция);
ДождатьсяКоличествоВыполняющихся(Стратегия, 1);

// Вторая задача попадает в очередь ожидания.
ВторойВызов = Пайплайн.ЗапуститьАсинх(Операция);
ДождатьсяКоличествоОжидающих(Стратегия, 1);

// Третья задача отклоняется, потому что слот занят и очередь уже заполнена.
ТретийВызов = Пайплайн.ЗапуститьАсинх(Операция);

// Выведет результат первой задачи: Данные получены за 300 мс
Сообщить(ПервыйВызов.Получить());

// Выведет результат второй задачи: Данные получены за 300 мс
Сообщить(ВторойВызов.Получить());

Попытка
	// В нормальном сценарии эта строка не выполнится: третья задача должна быть отклонена.
	Сообщить(ТретийВызов.Получить());
Исключение
	// Выведет сообщение вида: Третья задача отклонена: Превышен лимит параллелизма...
	Сообщить(СтрШаблон("Третья задача отклонена: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
КонецПопытки;
