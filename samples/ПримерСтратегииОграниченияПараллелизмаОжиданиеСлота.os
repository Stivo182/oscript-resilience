#Использовать ".."
#Использовать "."

// Пример показывает запрос, который готов немного подождать свободный рабочий слот.
// Если ожидание затягивается, стратегия отклоняет запрос вместо бесконечной очереди.

// Служебное ожидание нужно только для асинхронного примера: оно дожидается,
// пока долгая операция действительно займет рабочий слот.

Процедура ДождатьсяЗанятогоСлота(Стратегия)

	Для НомерПопытки = 1 По 50 Цикл
		Если Стратегия.КоличествоВыполняющихся() > 0 Тогда
			Возврат;
		КонецЕсли;

		Приостановить(10);
	КонецЦикла;

	ВызватьИсключение "Не удалось дождаться занятого слота параллелизма.";

КонецПроцедуры

// Подготовка
Сервис = Новый МедленныйСервис(300);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
Стратегия = Новый СтратегияОграниченияПараллелизма(1, 1);
Стратегия.УстановитьМаксимальноеОжиданиеСлота(100);
// При слишком долгом ожидании обработчик выведет: Запрос слишком долго ждал свободный слот.
Стратегия.УстановитьОбработчикПереполнения(
	"(КонтекстПереполнения) -> Сообщить(""Запрос слишком долго ждал свободный слот."")"
);

Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьСтратегию(Стратегия);

// Запуск
// Долгая операция занимает единственный слот.
ПервыйВызов = Пайплайн.ЗапуститьАсинх(Операция);
ДождатьсяЗанятогоСлота(Стратегия);

// Следующий запрос попадает в очередь, но не успевает дождаться слота.
Попытка
	Пайплайн.Запустить(Операция);
Исключение
	// Выведет сообщение вида: Запрос отклонен: Превышено максимальное ожидание слота параллелизма.
	Сообщить("Запрос отклонен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;

// Выведет: Долгая операция завершилась: Данные получены за 300 мс
Сообщить("Долгая операция завершилась: " + Строка(ПервыйВызов.Получить()));
