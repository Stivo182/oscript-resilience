#Использовать ".."
#Использовать "."

// Пример показывает внешний процесс, который завершается не сразу.
// Первые проверки возвращают "НЕ ГОТОВО", а стратегия повторяет опрос,
// пока сервис не сообщит об успешном завершении.

// Подготовка
Сервис = Новый СервисПроверкиГотовности(2);
Операция = Новый Действие(Сервис, "ПроверитьГотовность");

// Стратегия повторяет проверку готовности, пока сервис возвращает "НЕ ГОТОВО".
// Обработчик повтора выведет:
// Проверка еще не готова. Повтор #1 через 100 мс.
// Проверка еще не готова. Повтор #2 через 100 мс.

// Настройка
Стратегия = Новый СтратегияПовтора()
	.УстановитьМаксимумПовторов(2)
	.УстановитьЗадержку(100)
	.УстановитьУсловиеПовтора(
		"(КонтекстПопытки) ->
		|	Возврат КонтекстПопытки.ЕстьИсключение()
		|		Или КонтекстПопытки.Результат() = ""НЕ ГОТОВО"""
	)
	.УстановитьОбработчикПовтора(
		"(КонтекстПопытки) ->
		|	Сообщить(
		|		СтрШаблон(
		|			""Проверка еще не готова. Повтор #%1 через %2 мс."",
		|			КонтекстПопытки.СледующаяПопытка(),
		|			КонтекстПопытки.Задержка()
		|		)
		|	)"
	);

// Запуск
Результат = Стратегия.Применить(Операция);

// Выведет: Итоговый результат: ГОТОВО на попытке 3
Сообщить("Итоговый результат: " + Строка(Результат));
