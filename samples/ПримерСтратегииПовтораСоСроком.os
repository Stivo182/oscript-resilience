#Использовать ".."
#Использовать "."

// Пример показывает общий срок для всех попыток и пауз стратегии повтора.
// Первый вызов завершается временной ошибкой, но задержка 5000 мс
// не помещается в оставшийся срок 1000 мс. Вторая попытка не запускается.

// Подготовка
Сервис = Новый НестабильныйСервис(1);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

Стратегия = Новый СтратегияПовтора(2, 5000)
	.УстановитьОбработчикПовтора(
		"(КонтекстПопытки) -> Сообщить(
		|	СтрШаблон(
		|		""Повтор #%1 будет выполнен через %2 мс."",
		|		КонтекстПопытки.СледующаяПопытка(),
		|		КонтекстПопытки.Задержка()
		|	)
		|)"
	);

// Сигнал создается на каждый отдельный вызов.
Сигнал = Новый СигналПрерыванияОперации();
Сигнал.УстановитьСрок(1000);

Попытка
	Стратегия.Применить(Операция, , Сигнал);
Исключение
	// Обработчик повтора не вызывается, сохраняется исходная ошибка операции.
	Сообщить("Операция завершена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
