#Использовать ".."
#Использовать "."

// Пример показывает сервис, который временно недоступен.
// После нескольких ошибок предохранитель перестает пропускать вызовы,
// а затем разрешает пробную попытку восстановления.

// Подготовка
Сервис = Новый НестабильныйСервис(2);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
// После двух ошибок подряд стратегия временно перестанет пропускать вызовы.
// Обработчик размыкания выведет:
// Предохранитель разомкнут после очередной неудачной серии вызовов.
Стратегия = Новый СтратегияПредохранителя()
	.УстановитьПорогОшибок(2)
	.УстановитьДлительностьРазмыкания(500)
	.УстановитьОбработчикРазмыкания(
		"(КонтекстРазмыкания) -> Сообщить(
		|	""Предохранитель разомкнут после очередной неудачной серии вызовов.""
		|)"
	);

// Запуск
// Первые вызовы приведут предохранитель к разомкнутому состоянию.
Для НомерВызова = 1 По 3 Цикл
	Попытка
		Результат = Стратегия.Применить(Операция);
		// В этом примере эта строка не выполнится: первые вызовы завершаются ошибками.
		Сообщить(СтрШаблон("Вызов %1: %2", НомерВызова, Результат));
	Исключение
		// Первые два вызова выведут временную ошибку сервиса, третий - сообщение о разомкнутом предохранителе.
		Сообщить(СтрШаблон("Вызов %1 завершился ошибкой: %2", НомерВызова, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
КонецЦикла;

// Выведет: Состояние после серии ошибок: Разомкнут
Сообщить("Состояние после серии ошибок: " + Стратегия.Состояние());

// После ожидания стратегия разрешает одну пробную попытку.
Приостановить(600);

Попытка
	Результат = Стратегия.Применить(Операция);
	// Выведет: Пробный вызов после ожидания: Данные получены на попытке 3
	Сообщить("Пробный вызов после ожидания: " + Строка(Результат));
Исключение
	// В этом примере эта строка не выполнится: пробный вызов должен закрыть предохранитель.
	Сообщить("Пробный вызов завершился ошибкой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;

// Выведет: Текущее состояние: Закрыт
Сообщить("Текущее состояние: " + Стратегия.Состояние());
