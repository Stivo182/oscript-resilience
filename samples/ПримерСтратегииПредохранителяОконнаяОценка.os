#Использовать ".."
#Использовать "."

// Окно из двух вызовов разомкнет предохранитель, когда один вызов завершится ошибкой,
// а второй успешно: процент ошибок будет равен 50.
Сервис = Новый НестабильныйСервис(1);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

Стратегия = Новый СтратегияПредохранителя(10, 500)
	.УстановитьРазмерОкнаОценки(2)
	.УстановитьМинимумВызововДляОценки(2)
	.УстановитьПорогПроцентаОшибок(50)
	.УстановитьОбработчикРазмыкания(
		"(КонтекстРазмыкания) -> Сообщить(СтрШаблон(""Окно: %1 вызова, ошибок: %2, процент ошибок: %3."", КонтекстРазмыкания.КоличествоВызововВОкне(), КонтекстРазмыкания.КоличествоОшибокВОкне(), КонтекстРазмыкания.ПроцентОшибок()))"
	);

Попытка
	Стратегия.Применить(Операция);
Исключение
	Сообщить("Первый вызов завершился ошибкой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;

Сообщить("Второй вызов: " + Строка(Стратегия.Применить(Операция)));
Сообщить("Состояние стратегии: " + Стратегия.Состояние());
