#Использовать ".."
#Использовать "."

// Пример показывает нестабильный сервис: ошибки чередуются с успешными ответами,
// но доля ошибок уже достаточно высокая, чтобы временно разомкнуть предохранитель.

// Подготовка
Сервис = Новый НестабильныйСервис(1);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
// В окне из двух вызовов одна ошибка даст 50% ошибок.
// Обработчик размыкания выведет: Окно: 2 вызова, ошибок: 1, процент ошибок: 50.
Стратегия = Новый СтратегияПредохранителя(10, 500)
	.УстановитьРазмерОкнаОценки(2)
	.УстановитьМинимумВызововДляОценки(2)
	.УстановитьПорогПроцентаОшибок(50)
	.УстановитьОбработчикРазмыкания(
		"(КонтекстРазмыкания) -> Сообщить(
		|	СтрШаблон(
		|		""Окно: %1 вызова, ошибок: %2, процент ошибок: %3."",
		|		КонтекстРазмыкания.КоличествоВызововВОкне(),
		|		КонтекстРазмыкания.КоличествоОшибокВОкне(),
		|		КонтекстРазмыкания.ПроцентОшибок()
		|	)
		|)"
	);

// Запуск
Попытка
	Стратегия.Применить(Операция);
Исключение
	// Выведет: Первый вызов завершился ошибкой: Временный сбой сервиса.
	Сообщить("Первый вызов завершился ошибкой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;

// Выведет: Второй вызов: Данные получены на попытке 2
Сообщить("Второй вызов: " + Строка(Стратегия.Применить(Операция)));

// Выведет: Состояние стратегии: Разомкнут
Сообщить("Состояние стратегии: " + Стратегия.Состояние());
