#Использовать ".."
#Использовать "."

// Пример показывает восстановление сервиса: после ошибки предохранитель
// требует две успешные пробные попытки, прежде чем снова закрыться.

// Подготовка
Сервис = Новый НестабильныйСервис(1);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
// Одновременно разрешена только одна проба, поэтому успехи накапливаются последовательно.
Стратегия = Новый СтратегияПредохранителя(1, 300)
	.УстановитьЛимитПробныхВызовов(1)
	.УстановитьПорогУспешныхПробныхВызововДляЗакрытия(2);

// Запуск
Попытка
	Стратегия.Применить(Операция);
Исключение
	// Выведет: Первый вызов завершился ошибкой: Временный сбой сервиса.
	Сообщить("Первый вызов завершился ошибкой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;

// Выведет: Состояние после ошибки: Разомкнут
Сообщить("Состояние после ошибки: " + Стратегия.Состояние());
Приостановить(350);

// Выведет: Первая проба: Данные получены на попытке 2
Сообщить("Первая проба: " + Строка(Стратегия.Применить(Операция)));

// Выведет: Состояние после первой пробы: Полуразомкнут
Сообщить("Состояние после первой пробы: " + Стратегия.Состояние());

// Выведет: Вторая проба: Данные получены на попытке 3
Сообщить("Вторая проба: " + Строка(Стратегия.Применить(Операция)));

// Выведет: Состояние после второй пробы: Закрыт
Сообщить("Состояние после второй пробы: " + Стратегия.Состояние());
