#Использовать ".."
#Использовать "."

// Пример показывает внешний сервис, который отвечает слишком долго.
// Стратегия ограничивает время ожидания и возвращает ошибку таймаута.

// Подготовка
Сервис = Новый МедленныйСервис(300);
Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
// Обработчик таймаута выведет сообщение вида:
// Таймаут 100 мс сработал после ожидания 1xx мс.
Стратегия = Новый СтратегияТаймаута(100);
Стратегия.УстановитьОбработчикТаймаута(
	"(КонтекстТаймаута) -> Сообщить(
	|	СтрШаблон(
	|		""Таймаут %1 мс сработал после ожидания %2 мс."",
	|		КонтекстТаймаута.Таймаут(),
	|		КонтекстТаймаута.ДлительностьВыполнения()
	|	)
	|)"
);

// Запуск
Попытка
	Стратегия.Применить(Операция);
Исключение
	// Выведет сообщение вида: Операция не уложилась в таймаут: Превышен таймаут выполнения: 100 мс.
	Сообщить("Операция не уложилась в таймаут: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
