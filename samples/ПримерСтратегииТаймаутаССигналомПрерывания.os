#Использовать ".."
#Использовать "."

// Пример показывает кооперативное завершение: пользовательский код получает
// тот же сигнал, что и стратегия таймаута, и сам проверяет его во время работы.

// Подготовка
СигналПрерыванияОперации = Новый СигналПрерыванияОперации();

Сервис = Новый ПрерываемыйСервис(300);
Сервис.УстановитьСигналПрерывания(СигналПрерыванияОперации);

Операция = Новый Действие(Сервис, "ПолучитьДанные");

// Настройка
// Обработчик таймаута выведет сообщение вида:
// Таймаут 100 мс: стратегия вызвала ЗапроситьПрерывание после ожидания 1xx мс.
Стратегия = Новый СтратегияТаймаута(100);
Стратегия.УстановитьОбработчикТаймаута(
	"(КонтекстТаймаута) -> Сообщить(
	|	СтрШаблон(
	|		""Таймаут %1 мс: стратегия вызвала ЗапроситьПрерывание после ожидания %2 мс."",
	|		КонтекстТаймаута.Таймаут(),
	|		КонтекстТаймаута.ДлительностьВыполнения()
	|	)
	|)"
);

Пайплайн = Новый ПайплайнОтказоустойчивости()
	.ДобавитьСтратегию(Стратегия);

// Запуск
Попытка
	// Один и тот же сигнал передается в запуск пайплайна и проверяется сервисом.
	// При превышении таймаута СтратегияТаймаута сама вызовет
	// СигналПрерыванияОперации.ЗапроситьПрерывание(...).
	Пайплайн.Запустить(Операция, , СигналПрерыванияОперации);
Исключение
	// Выведет сообщение вида: Операция остановлена по таймауту: Превышен таймаут выполнения: 100 мс.
	Сообщить("Операция остановлена по таймауту: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
