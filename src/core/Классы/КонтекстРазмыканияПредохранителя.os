Перем _ПорогОшибок; // Число
Перем _КоличествоОшибокПодряд; // Число
Перем _ДлительностьРазмыкания; // Число
Перем _ДанныеОшибки; // ИнформацияОбОшибке, Неопределено
Перем _Состояние; // Строка
Перем _КоличествоВызововВОкне; // Число
Перем _КоличествоОшибокВОкне; // Число
Перем _ПроцентОшибок; // Число
Перем _ПричинаРазмыкания; // Строка - см. ПричиныРазмыканияПредохранителя

#Область ОбработчикиСобытий

// Контекст размыкания стратегии предохранителя.
//
// Параметры:
//   ПорогОшибок - Число - Количество ошибок подряд, после которого предохранитель размыкается
//   КоличествоОшибокПодряд - Число - Текущее количество подряд идущих ошибок
//   ДлительностьРазмыкания - Число - Миллисекунд до перехода в режим пробной попытки
//   ДанныеОшибки - ИнформацияОбОшибке, Неопределено - Дополнительная информация об ошибке,
//     вызвавшей размыкание
//   Состояние - Строка - Текущее состояние предохранителя
//   КоличествоВызововВОкне - Число - Необязательный. Количество завершенных вызовов в окне оценки.
//     По умолчанию: 0
//   КоличествоОшибокВОкне - Число - Необязательный. Количество ошибок в окне оценки.
//     По умолчанию: 0
//   ПроцентОшибок - Число - Необязательный. Процент ошибок в окне оценки.
//     По умолчанию: 0
//   ПричинаРазмыкания - Строка - Необязательный. Причина размыкания предохранителя,
//     см. ПричиныРазмыканияПредохранителя. По умолчанию:
//     ПричиныРазмыканияПредохранителя.ПоследовательныеОшибки
Процедура ПриСозданииОбъекта(
	ПорогОшибок,
	КоличествоОшибокПодряд,
	ДлительностьРазмыкания,
	ДанныеОшибки,
	Состояние,
	КоличествоВызововВОкне = 0,
	КоличествоОшибокВОкне = 0,
	ПроцентОшибок = 0,
	ПричинаРазмыкания = Неопределено)

	Если ПричинаРазмыкания = Неопределено Тогда
		ПричинаРазмыкания = ПричиныРазмыканияПредохранителя.ПоследовательныеОшибки;
	КонецЕсли;

	_ПорогОшибок = ПорогОшибок;
	_КоличествоОшибокПодряд = КоличествоОшибокПодряд;
	_ДлительностьРазмыкания = ДлительностьРазмыкания;
	_ДанныеОшибки = ДанныеОшибки;
	_Состояние = Состояние;
	_КоличествоВызововВОкне = КоличествоВызововВОкне;
	_КоличествоОшибокВОкне = КоличествоОшибокВОкне;
	_ПроцентОшибок = ПроцентОшибок;
	_ПричинаРазмыкания = ПричинаРазмыкания;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Количество ошибок подряд, после которого предохранитель размыкается.
//
// Возвращаемое значение:
//   Число
Функция ПорогОшибок() Экспорт
	Возврат _ПорогОшибок;
КонецФункции

// Текущее количество подряд идущих ошибок.
//
// Возвращаемое значение:
//   Число
Функция КоличествоОшибокПодряд() Экспорт
	Возврат _КоличествоОшибокПодряд;
КонецФункции

// Длительность размыкания.
//
// Возвращаемое значение:
//   Число - Миллисекунд
Функция ДлительностьРазмыкания() Экспорт
	Возврат _ДлительностьРазмыкания;
КонецФункции

// Дополнительная информация об ошибке, вызвавшей размыкание.
//
// Возвращаемое значение:
//   ИнформацияОбОшибке, Неопределено
Функция ДанныеОшибки() Экспорт
	Возврат _ДанныеОшибки;
КонецФункции

// Текущее состояние предохранителя.
//
// Возвращаемое значение:
//   Строка - см. СостоянияПредохранителя
Функция Состояние() Экспорт
	Возврат _Состояние;
КонецФункции

// Количество завершенных вызовов в окне оценки.
//
// Возвращаемое значение:
//   Число
Функция КоличествоВызововВОкне() Экспорт
	Возврат _КоличествоВызововВОкне;
КонецФункции

// Количество ошибок в окне оценки.
//
// Возвращаемое значение:
//   Число
Функция КоличествоОшибокВОкне() Экспорт
	Возврат _КоличествоОшибокВОкне;
КонецФункции

// Процент ошибок в окне оценки.
//
// Возвращаемое значение:
//   Число
Функция ПроцентОшибок() Экспорт
	Возврат _ПроцентОшибок;
КонецФункции

// Причина размыкания предохранителя.
//
// Возвращаемое значение:
//   Строка - см. ПричиныРазмыканияПредохранителя
Функция ПричинаРазмыкания() Экспорт
	Возврат _ПричинаРазмыкания;
КонецФункции

#КонецОбласти
