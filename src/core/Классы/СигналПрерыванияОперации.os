#Использовать logos
#Использовать errors

Перем _ПрерываниеЗапрошено; // Булево
Перем _ПричинаПрерывания; // Строка, Неопределено
Перем _КодПрерывания; // Строка, Неопределено
Перем _ДлительностьСрока; // Число, Неопределено
Перем _МоментИстеченияСрока; // Число, Неопределено
Перем _БлокировкаРесурса; // БлокировкаРесурса

#Область ОбработчикиСобытий

// Сигнал кооперативного прерывания пользовательской операции.
Процедура ПриСозданииОбъекта()

	_ПрерываниеЗапрошено = Ложь;
	_ПричинаПрерывания = Неопределено;
	_КодПрерывания = Неопределено;
	_ДлительностьСрока = Неопределено;
	_МоментИстеченияСрока = Неопределено;
	_БлокировкаРесурса = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Устанавливает срок операции относительно текущего момента.
//
// Параметры:
//   Длительность - Число - Длительность срока в миллисекундах
//
// Исключения:
//   argument.out_of_range - Длительность меньше 0
Процедура УстановитьСрок(Длительность) Экспорт

	Если Длительность < 0 Тогда
		ВызватьИсключение ФабрикаОшибок.Создать(
			КодыСтандартныхОшибок.АргументВнеДиапазона(),
			"Длительность срока не может быть меньше 0."
		);
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбновитьСостояниеПрерыванияПоСроку();

		Если Не _ПрерываниеЗапрошено Тогда
			_ДлительностьСрока = Длительность;
			_МоментИстеченияСрока = ТекущаяУниверсальнаяДатаВМиллисекундах() + Длительность;
			ОбновитьСостояниеПрерыванияПоСроку();
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

КонецПроцедуры

// Запрашивает кооперативное прерывание операции.
//
// Параметры:
//   ПричинаПрерывания - Строка - Причина запрошенного прерывания
Процедура ЗапроситьПрерывание(ПричинаПрерывания = Неопределено) Экспорт

	УжеЗапрошено = Ложь;
	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбновитьСостояниеПрерыванияПоСроку();

		Если _ПрерываниеЗапрошено Тогда
			УжеЗапрошено = Истина;
		Иначе
			_ПрерываниеЗапрошено = Истина;
			_ПричинаПрерывания = ПричинаПрерывания;
			_КодПрерывания = КодыОшибокОтказоустойчивости.ОтменаОперации();
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Если УжеЗапрошено Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

// Возвращает признак запрошенного прерывания.
//
// Возвращаемое значение:
//   Булево
Функция ПрерываниеЗапрошено() Экспорт

	ПрерываниеЗапрошено = Ложь;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбновитьСостояниеПрерыванияПоСроку();
		ПрерываниеЗапрошено = _ПрерываниеЗапрошено;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ПрерываниеЗапрошено;

КонецФункции

// Возвращает причину прерывания операции.
//
// Возвращаемое значение:
//   Строка, Неопределено
Функция ПричинаПрерывания() Экспорт

	ПричинаПрерывания = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбновитьСостояниеПрерыванияПоСроку();
		ПричинаПрерывания = _ПричинаПрерывания;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ПричинаПрерывания;

КонецФункции

// Возвращает оставшееся до истечения срока время.
//
// Возвращаемое значение:
//   Число - Оставшееся время в миллисекундах, не меньше 0
//   Неопределено - Срок не установлен
Функция ОсталосьВремени() Экспорт

	ОсталосьВремени = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбновитьСостояниеПрерыванияПоСроку();

		Если _МоментИстеченияСрока <> Неопределено Тогда
			ОсталосьВремени = Макс(0, _МоментИстеченияСрока - ТекущаяУниверсальнаяДатаВМиллисекундах());
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ОсталосьВремени;

КонецФункции

// Вызывает исключение, если прерывание уже было запрошено.
//
// Исключения:
//   resilience.operation.cancelled - Запрошена отмена операции
//   resilience.operation.deadline_exceeded - Истек срок операции
Процедура ПроверитьПрерывание() Экспорт

	Если Не ПрерываниеЗапрошено() Тогда
		Возврат;
	КонецЕсли;

	ТекущаяПричинаПрерывания = ПричинаПрерывания();
	ТекущийКодПрерывания = КодПрерывания();

	Если Не ЗначениеЗаполнено(ТекущаяПричинаПрерывания) Тогда
		Сообщение = "Выполнение операции отменено.";
	Иначе
		Сообщение = ТекущаяПричинаПрерывания;
	КонецЕсли;

	ВызватьИсключение ФабрикаОшибок.Создать(
		ТекущийКодПрерывания,
		Сообщение
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьСостояниеПрерыванияПоСроку()

	Если _ПрерываниеЗапрошено
		Или _МоментИстеченияСрока = Неопределено
		Или ТекущаяУниверсальнаяДатаВМиллисекундах() < _МоментИстеченияСрока Тогда
		Возврат;
	КонецЕсли;

	_ПрерываниеЗапрошено = Истина;
	_ПричинаПрерывания = СтрШаблон("Истек срок операции: %1 мс.", _ДлительностьСрока);
	_КодПрерывания = КодыОшибокОтказоустойчивости.ПревышениеСрокаОперации();

КонецПроцедуры

Функция КодПрерывания()

	КодПрерывания = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбновитьСостояниеПрерыванияПоСроку();
		КодПрерывания = _КодПрерывания;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат КодПрерывания;

КонецФункции

#КонецОбласти
