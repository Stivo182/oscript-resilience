#Использовать logos

Перем _Обработчик; // ОбработчикОтказоустойчивости, Неопределено
Перем _УсловиеЗапасногоСценария; // ОбработчикОтказоустойчивости, Неопределено
Перем _БлокировкаРесурса; // БлокировкаРесурса
Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Стратегия резервного действия при ошибке основной операции.
//
// Параметры:
//   Обработчик - Действие, Строка, Неопределено - Действие или лямбда-выражение,
//                                                 выполняемое при ошибке основной операции.
//                                                 Обработчик принимает КонтекстОшибкиЗапасногоСценария
//   ДополнительныеПараметры - Массив - Дополнительные параметры обработчика
//                           - ФиксированныйМассив - Дополнительные параметры обработчика
//                           - Произвольный - Дополнительный параметр обработчика
//                           - Неопределено - Без дополнительных параметров
Процедура ПриСозданииОбъекта(Обработчик = Неопределено, ДополнительныеПараметры = Неопределено)
	
	_БлокировкаРесурса = Новый БлокировкаРесурса(ЭтотОбъект);

	Если Обработчик <> Неопределено Тогда
		УстановитьОбработчик(Обработчик, ДополнительныеПараметры);
	КонецЕсли;
	
	_Лог = Логирование.ПолучитьЛог("oscript.lib.resilience.СтратегияЗапасногоСценария");
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет операцию и при ошибке возвращает результат действия при ошибке, если прерывание не запрошено.
//
// Параметры:
//   Операция - Действие - Выполняемая операция
//            - ШагПайплайнаОтказоустойчивости - Вложенный шаг пайплайна
//            - Строка - Лямбда-выражение операции
//   Параметры - Массив - Параметры для передачи в операцию
//             - ФиксированныйМассив - Параметры для передачи в операцию
//             - Произвольный - Первый параметр операции
//             - Неопределено - Без параметров
//   СигналПрерыванияОперации - СигналПрерыванияОперации - Сигнал кооперативного прерывания операции
//                            - Неопределено - Без сигнала прерывания
//
// Возвращаемое значение:
//   Произвольный - Результат основной или резервной операции
//
// Если прерывание уже запрошено до запуска операции или было запрошено во время выполнения,
// исключение пробрасывается без выполнения резервной операции.
Функция Применить(
	Операция,
	Параметры = Неопределено,
	СигналПрерыванияОперации = Неопределено) Экспорт

	АдаптерОперации = Новый АдаптерОперацииОтказоустойчивости();
	ТекущаяОперация = АдаптерОперации.Подготовить(Операция, Параметры);
	НастройкиЗапасногоСценария = ПолучитьНастройкиЗапасногоСценария();

	Если СигналПрерыванияОперации <> Неопределено Тогда
		СигналПрерыванияОперации.ПроверитьПрерывание();
	КонецЕсли;

	Попытка

		Возврат ТекущаяОперация.Запустить(СигналПрерыванияОперации);

	Исключение

		ДанныеОшибки = ИнформацияОбОшибке();

		Если ПрерываниеЗапрошено(СигналПрерыванияОперации) Тогда
			ВызватьИсключение;
		КонецЕсли;

		Если НастройкиЗапасногоСценария.Обработчик = Неопределено Тогда
			ВызватьИсключение;
		КонецЕсли;

		КонтекстОшибки = Новый КонтекстОшибкиЗапасногоСценария(ДанныеОшибки);

		Если Не СледуетВыполнятьЗапаснойСценарий(
			НастройкиЗапасногоСценария.УсловиеЗапасногоСценария,
			КонтекстОшибки
		) Тогда
			ВызватьИсключение;
		КонецЕсли;

		Возврат ВыполнитьЗапаснойСценарий(
			НастройкиЗапасногоСценария.Обработчик,
			КонтекстОшибки
		);

	КонецПопытки;

КонецФункции

// Устанавливает обработчик, который будет выполнен при ошибке основной операции.
//
// Параметры:
//   Обработчик - Действие, Строка - Действие или лямбда-выражение,
//                                   выполняемое при ошибке основной операции.
//                                   Обработчик принимает КонтекстОшибкиЗапасногоСценария
//   ДополнительныеПараметры - Массив - Дополнительные параметры обработчика
//                           - ФиксированныйМассив - Дополнительные параметры обработчика
//                           - Произвольный - Дополнительный параметр обработчика
//                           - Неопределено - Без дополнительных параметров
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьОбработчик(Обработчик, ДополнительныеПараметры = Неопределено) Экспорт
	
	ПодготовленныйОбработчик = Новый ОбработчикОтказоустойчивости(Обработчик, ДополнительныеПараметры);

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_Обработчик = ПодготовленныйОбработчик;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает условие, которое решает, нужно ли выполнять запасной сценарий.
//
// Параметры:
//   Условие - Действие, Строка - Действие или лямбда-выражение,
//                                принимающее КонтекстОшибкиЗапасногоСценария
//                                и возвращающее Булево
//   ДополнительныеПараметры - Массив - Дополнительные параметры условия
//                           - ФиксированныйМассив - Дополнительные параметры условия
//                           - Произвольный - Дополнительный параметр условия
//                           - Неопределено - Без дополнительных параметров
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьУсловиеЗапасногоСценария(Условие, ДополнительныеПараметры = Неопределено) Экспорт

	ПодготовленныйОбработчик = Новый ОбработчикОтказоустойчивости(
		Условие,
		ДополнительныеПараметры,
		Истина
	);

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_УсловиеЗапасногоСценария = ПодготовленныйОбработчик;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрерываниеЗапрошено(СигналПрерыванияОперации)

	Возврат СигналПрерыванияОперации <> Неопределено
		И СигналПрерыванияОперации.ПрерываниеЗапрошено();

КонецФункции

Функция СледуетВыполнятьЗапаснойСценарий(УсловиеЗапасногоСценария, КонтекстОшибки)

	Если УсловиеЗапасногоСценария = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат УсловиеЗапасногоСценария.Вызвать(КонтекстОшибки);

КонецФункции

Функция ВыполнитьЗапаснойСценарий(Обработчик, КонтекстОшибки)

	_Лог.Отладка(
		"Основная операция завершилась ошибкой. Будет выполнен запасной сценарий: %1",
		КраткоеПредставлениеОшибки(КонтекстОшибки.ДанныеОшибки())
	);

	Возврат Обработчик.Вызвать(КонтекстОшибки);

КонецФункции

Функция ПолучитьНастройкиЗапасногоСценария()

	НастройкиЗапасногоСценария = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		НастройкиЗапасногоСценария = Новый Структура();
		НастройкиЗапасногоСценария.Вставить("Обработчик", _Обработчик);
		НастройкиЗапасногоСценария.Вставить("УсловиеЗапасногоСценария", _УсловиеЗапасногоСценария);
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат НастройкиЗапасногоСценария;

КонецФункции

#КонецОбласти
