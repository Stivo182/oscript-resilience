#Использовать logos
#Использовать "../../internal"

Перем _ЛимитВызовов; // Число
Перем _ИнтервалЛимита; // Число
Перем _МаксимальноеОжиданиеРазрешения; // Число
Перем _ТипОграничения; // Строка - см. ТипыОграниченияВызовов
Перем _СледующееРазрешение; // Число
Перем _НачалоИнтервала; // Число
Перем _КоличествоВызововЗаИнтервал; // Число
Перем _ОбработчикПревышенияЛимита; // ОбработчикОтказоустойчивости, Неопределено
Перем _БлокировкаРесурса; // БлокировкаРесурса
Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Стратегия ограничения количества вызовов за заданный интервал.
//
// Параметры:
//   ЛимитВызовов - Число - Максимально допустимое количество вызовов за интервал
//   ИнтервалЛимита - Число - Длительность интервала лимита в миллисекундах
Процедура ПриСозданииОбъекта(ЛимитВызовов = 10, ИнтервалЛимита = 1000)

	_НачалоИнтервала = Неопределено;
	_КоличествоВызововЗаИнтервал = 0;
	_МаксимальноеОжиданиеРазрешения = 0;
	_ТипОграничения = ТипыОграниченияВызовов.ФиксированноеОкно;
	_СледующееРазрешение = 0;
	_БлокировкаРесурса = Новый БлокировкаРесурса(ЭтотОбъект);
	_Лог = Логирование.ПолучитьЛог("oscript.lib.resilience.СтратегияОграниченияВызовов");
	
	УстановитьЛимитВызовов(ЛимитВызовов);
	УстановитьИнтервалЛимита(ИнтервалЛимита);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет операцию, если лимит вызовов в текущем интервале не исчерпан.
//
// Параметры:
//   Операция - Действие - Выполняемая операция
//            - ШагПайплайнаОтказоустойчивости - Вложенный шаг пайплайна
//            - Строка - Лямбда-выражение операции
//   Параметры - Массив - Параметры для передачи в операцию
//             - ФиксированныйМассив - Параметры для передачи в операцию
//             - Произвольный - Первый параметр операции
//             - Неопределено - Без параметров
//   СигналПрерыванияОперации - СигналПрерыванияОперации - Сигнал кооперативного прерывания операции
//                            - Неопределено - Без сигнала прерывания
//
// Возвращаемое значение:
//   Произвольный - Результат выполнения операции
Функция Применить(
	Операция,
	Параметры = Неопределено,
	СигналПрерыванияОперации = Неопределено) Экспорт

	АдаптерОперации = Новый АдаптерОперацииОтказоустойчивости();
	ТекущаяОперация = АдаптерОперации.Подготовить(Операция, Параметры);
	ПревышениеЛимита = ПолучитьРазрешениеИлиПодготовитьПревышениеЛимита(СигналПрерыванияОперации);

	Если ПревышениеЛимита <> Неопределено Тогда
		КонтекстПревышенияЛимита = ПревышениеЛимита.КонтекстПревышенияЛимита;
		ОбработатьПревышениеЛимита(
			ПревышениеЛимита.ОбработчикПревышенияЛимита,
			КонтекстПревышенияЛимита
		);
		ВызватьИсключение СформироватьТекстПревышенияЛимита(КонтекстПревышенияЛимита);
	КонецЕсли;

	Возврат ТекущаяОперация.Запустить(СигналПрерыванияОперации);

КонецФункции

// Устанавливает максимально допустимое количество вызовов за интервал.
//
// Параметры:
//   ЛимитВызовов - Число - Максимально допустимое количество вызовов за интервал
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьЛимитВызовов(ЛимитВызовов) Экспорт

	Если ЛимитВызовов <= 0 Тогда
		ВызватьИсключение "Лимит вызовов должен быть больше 0.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ЛимитВызовов = ЛимитВызовов;
		Если _ТипОграничения = ТипыОграниченияВызовов.РавномерноеРаспределение Тогда
			СброситьСостояниеОграниченияВызовов();
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает длительность интервала лимита.
//
// Параметры:
//   ИнтервалЛимита - Число - Миллисекунд
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьИнтервалЛимита(ИнтервалЛимита) Экспорт

	Если ИнтервалЛимита <= 0 Тогда
		ВызватьИсключение "Интервал лимита должен быть больше 0 мс.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ИнтервалЛимита = ИнтервалЛимита;
		Если _ТипОграничения = ТипыОграниченияВызовов.РавномерноеРаспределение Тогда
			СброситьСостояниеОграниченияВызовов();
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает максимальное время ожидания разрешения на вызов.
//
// Параметры:
//   МаксимальноеОжиданиеРазрешения - Число - Миллисекунд. 0 означает отказ без ожидания
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьМаксимальноеОжиданиеРазрешения(МаксимальноеОжиданиеРазрешения) Экспорт

	Если МаксимальноеОжиданиеРазрешения < 0 Тогда
		ВызватьИсключение "Максимальное ожидание разрешения не может быть меньше 0.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_МаксимальноеОжиданиеРазрешения = МаксимальноеОжиданиеРазрешения;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает тип ограничения вызовов.
//
// Параметры:
//   ТипОграничения - Строка - См. ТипыОграниченияВызовов
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьТипОграничения(ТипОграничения) Экспорт

	Если ТипОграничения <> ТипыОграниченияВызовов.ФиксированноеОкно
		И ТипОграничения <> ТипыОграниченияВызовов.РавномерноеРаспределение Тогда
		ВызватьИсключение "Неизвестный тип ограничения вызовов: " + ТипОграничения;
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Если _ТипОграничения <> ТипОграничения Тогда
			_ТипОграничения = ТипОграничения;
			СброситьСостояниеОграниченияВызовов();
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает обработчик, который вызывается при превышении лимита вызовов.
//
// Параметры:
//   Обработчик - Действие, Строка - Действие или лямбда-выражение, принимающее контекст превышения лимита
//   ДополнительныеПараметры - Массив - Дополнительные параметры обработчика
//                           - ФиксированныйМассив - Дополнительные параметры обработчика
//                           - Произвольный - Дополнительный параметр обработчика
//                           - Неопределено - Без дополнительных параметров
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьОбработчикПревышенияЛимита(Обработчик, ДополнительныеПараметры = Неопределено) Экспорт

	ПодготовленныйОбработчик = Новый ОбработчикОтказоустойчивости(
		Обработчик,
		ДополнительныеПараметры,
		Ложь
	);

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ОбработчикПревышенияЛимита = ПодготовленныйОбработчик;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Максимально допустимое количество вызовов за интервал.
//
// Возвращаемое значение:
//   Число
Функция ЛимитВызовов() Экспорт
	
	ЛимитВызовов = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ЛимитВызовов = _ЛимитВызовов;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЛимитВызовов;

КонецФункции

// Длительность интервала лимита.
//
// Возвращаемое значение:
//   Число - Миллисекунд
Функция ИнтервалЛимита() Экспорт
	
	ИнтервалЛимита = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ИнтервалЛимита = _ИнтервалЛимита;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ИнтервалЛимита;

КонецФункции

// Максимальное время ожидания разрешения на вызов.
//
// Возвращаемое значение:
//   Число - Миллисекунд. 0 означает отказ без ожидания
Функция МаксимальноеОжиданиеРазрешения() Экспорт

	МаксимальноеОжиданиеРазрешения = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		МаксимальноеОжиданиеРазрешения = _МаксимальноеОжиданиеРазрешения;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат МаксимальноеОжиданиеРазрешения;

КонецФункции

// Тип ограничения вызовов.
//
// Возвращаемое значение:
//   Строка - См. ТипыОграниченияВызовов
Функция ТипОграничения() Экспорт

	ТипОграничения = "";

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ТипОграничения = _ТипОграничения;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ТипОграничения;

КонецФункции

// Количество вызовов, уже выполненных в текущем интервале.
//
// Возвращаемое значение:
//   Число
Функция КоличествоВызововЗаИнтервал() Экспорт

	КоличествоВызововЗаИнтервал = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Если _НачалоИнтервала <> Неопределено Тогда
			ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
			Если НЕ НачатыйИнтервалИстек(ТекущееВремя) Тогда
				КоличествоВызововЗаИнтервал = _КоличествоВызововЗаИнтервал;
			КонецЕсли;
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат КоличествоВызововЗаИнтервал;

КонецФункции

// Сбрасывает текущий интервал лимита вызовов.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Сбросить() Экспорт

	_БлокировкаРесурса.Заблокировать();

	Попытка
		НачатьНовыйИнтервал();
		СброситьРасписаниеРавномерногоРаспределения();
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	_Лог.Отладка("Текущий интервал лимита вызовов сброшен вручную.");

	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьРазрешениеИлиПодготовитьПревышениеЛимита(СигналПрерыванияОперации)

	МоментНачалаОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока Истина Цикл
		РезультатПолученияРазрешения = ПопробоватьПолучитьРазрешение(
			МоментНачалаОжидания,
			СигналПрерыванияОперации
		);

		Если РезультатПолученияРазрешения.Состояние = СостоянияПолученияРазрешенияВызова.Разрешено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Если РезультатПолученияРазрешения.Состояние = СостоянияПолученияРазрешенияВызова.Отклонено Тогда
			Возврат РезультатПолученияРазрешения.ПревышениеЛимита;
		КонецЕсли;

		ОжидатьРазрешение(
			РезультатПолученияРазрешения.ОсталосьОжидать,
			СигналПрерыванияОперации
		);
	КонецЦикла;

КонецФункции

Функция ПопробоватьПолучитьРазрешение(МоментНачалаОжидания, СигналПрерыванияОперации)

	РезультатПолученияРазрешения = СоздатьРезультатПолученияРазрешения(
		СостоянияПолученияРазрешенияВызова.Отклонено
	);

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ПроверитьПрерываниеОперации(СигналПрерыванияОперации);

		РезультатПолученияРазрешения = ПодготовитьРезультатПолученияРазрешения(МоментНачалаОжидания);
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат РезультатПолученияРазрешения;

КонецФункции

Функция ПодготовитьРезультатПолученияРазрешения(МоментНачалаОжидания)

	Если _ТипОграничения = ТипыОграниченияВызовов.РавномерноеРаспределение Тогда
		Возврат ПодготовитьРезультатРавномерногоРаспределения(МоментНачалаОжидания);
	КонецЕсли;

	Возврат ПодготовитьРезультатФиксированногоОкна(МоментНачалаОжидания);

КонецФункции

Функция ПодготовитьРезультатФиксированногоОкна(МоментНачалаОжидания)

	ПревышениеЛимита = ЗарегистрироватьВызовИПодготовитьПревышениеЛимита();
	Если ПревышениеЛимита = Неопределено Тогда
		Возврат СоздатьРезультатПолученияРазрешения(СостоянияПолученияРазрешенияВызова.Разрешено);
	КонецЕсли;

	Если МожноДождатьсяРазрешенияПоПревышению(ПревышениеЛимита, МоментНачалаОжидания) Тогда
		ОсталосьОжидать = ПревышениеЛимита.КонтекстПревышенияЛимита.ОсталосьОжидать();
		Возврат СоздатьРезультатПолученияРазрешения(
			СостоянияПолученияРазрешенияВызова.ОжидатьИПовторить,
			Неопределено,
			ОсталосьОжидать
		);
	КонецЕсли;

	Возврат СоздатьРезультатПолученияРазрешения(
		СостоянияПолученияРазрешенияВызова.Отклонено,
		ПревышениеЛимита
	);

КонецФункции

Функция ПодготовитьРезультатРавномерногоРаспределения(МоментНачалаОжидания)

	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИнтервалМеждуВызовами = ИнтервалМеждуРаспределеннымиВызовами();

	Если _СледующееРазрешение = 0 Или ТекущееВремя >= _СледующееРазрешение Тогда
		ЗарегистрироватьРаспределенныйВызов(ТекущееВремя);
		_СледующееРазрешение = ТекущееВремя + ИнтервалМеждуВызовами;
		Возврат СоздатьРезультатПолученияРазрешения(СостоянияПолученияРазрешенияВызова.Разрешено);
	КонецЕсли;

	ОсталосьОжидать = _СледующееРазрешение - ТекущееВремя;
	Если Не МожноДождатьсяРазрешенияПоОстатку(
		ОсталосьОжидать,
		_МаксимальноеОжиданиеРазрешения,
		МоментНачалаОжидания) Тогда
		ПревышениеЛимита = СоздатьПревышениеЛимита(ОсталосьОжидать, _МаксимальноеОжиданиеРазрешения);
		Возврат СоздатьРезультатПолученияРазрешения(
			СостоянияПолученияРазрешенияВызова.Отклонено,
			ПревышениеЛимита
		);
	КонецЕсли;

	Возврат СоздатьРезультатПолученияРазрешения(
		СостоянияПолученияРазрешенияВызова.ОжидатьИПовторить,
		Неопределено,
		ОсталосьОжидать
	);

КонецФункции

Функция СоздатьРезультатПолученияРазрешения(Состояние, ПревышениеЛимита = Неопределено, ОсталосьОжидать = 0)

	Возврат Новый Структура(
		"Состояние, ПревышениеЛимита, ОсталосьОжидать",
		Состояние,
		ПревышениеЛимита,
		ОсталосьОжидать
	);

КонецФункции

Функция ЗарегистрироватьВызовИПодготовитьПревышениеЛимита()

	ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОбновитьИнтервалДляВызоваЕслиНужно(ТекущееВремя);

	Если _КоличествоВызововЗаИнтервал >= _ЛимитВызовов Тогда
		ОсталосьОжидать = ОпределитьОстатокОжидания(ТекущееВремя);

		Возврат СоздатьПревышениеЛимита(ОсталосьОжидать, _МаксимальноеОжиданиеРазрешения);
	КонецЕсли;

	_КоличествоВызововЗаИнтервал = _КоличествоВызововЗаИнтервал + 1;
	_Лог.Отладка(
		"Разрешен вызов %1 из %2 в текущем интервале лимита.",
		_КоличествоВызововЗаИнтервал,
		_ЛимитВызовов
	);

	Возврат Неопределено;

КонецФункции

Процедура ЗарегистрироватьРаспределенныйВызов(ТекущееВремя)

	ОбновитьИнтервалДляВызоваЕслиНужно(ТекущееВремя);

	_КоличествоВызововЗаИнтервал = _КоличествоВызововЗаИнтервал + 1;
	_Лог.Отладка(
		"Разрешен вызов равномерного распределения %1 в текущем интервале лимита.",
		_КоличествоВызововЗаИнтервал
	);

КонецПроцедуры

Функция СоздатьПревышениеЛимита(ОсталосьОжидать, МаксимальноеОжиданиеРазрешения)

	КонтекстПревышенияЛимита = СоздатьКонтекстПревышенияЛимита(ОсталосьОжидать);

	Возврат Новый Структура(
		"КонтекстПревышенияЛимита, ОбработчикПревышенияЛимита, МаксимальноеОжиданиеРазрешения",
		КонтекстПревышенияЛимита,
		_ОбработчикПревышенияЛимита,
		МаксимальноеОжиданиеРазрешения
	);

КонецФункции

Функция МожноДождатьсяРазрешенияПоПревышению(ПревышениеЛимита, МоментНачалаОжидания)

	МаксимальноеОжиданиеРазрешения = ПревышениеЛимита.МаксимальноеОжиданиеРазрешения;
	ОсталосьОжидать = ПревышениеЛимита.КонтекстПревышенияЛимита.ОсталосьОжидать();

	Возврат МожноДождатьсяРазрешенияПоОстатку(
		ОсталосьОжидать,
		МаксимальноеОжиданиеРазрешения,
		МоментНачалаОжидания
	);

КонецФункции

Функция МожноДождатьсяРазрешенияПоОстатку(
	ОсталосьОжидать,
	МаксимальноеОжиданиеРазрешения,
	МоментНачалаОжидания)

	Если МаксимальноеОжиданиеРазрешения <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	УжеОжидали = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачалаОжидания;

	Возврат УжеОжидали + ОсталосьОжидать <= МаксимальноеОжиданиеРазрешения;

КонецФункции

Процедура ОжидатьРазрешение(ОсталосьОжидать, СигналПрерыванияОперации)

	_Лог.Отладка("Ожидание разрешения на вызов: %1 мс.", ОсталосьОжидать);

	ОжиданиеОтказоустойчивости.ПриостановитьСПроверкойПрерывания(
		ОсталосьОжидать,
		СигналПрерыванияОперации
	);

КонецПроцедуры

Процедура ОбработатьПревышениеЛимита(ОбработчикПревышенияЛимита, КонтекстПревышенияЛимита)

	Если ОбработчикПревышенияЛимита = Неопределено Тогда
		Возврат;
	КонецЕсли;

	_Лог.Отладка(
		"Вызывается обработчик превышения лимита. Осталось ожидать: %1 мс.",
		КонтекстПревышенияЛимита.ОсталосьОжидать()
	);

	ОбработчикПревышенияЛимита.Вызвать(КонтекстПревышенияЛимита);

КонецПроцедуры

Функция СоздатьКонтекстПревышенияЛимита(ОсталосьОжидать)

	Возврат Новый КонтекстПревышенияЛимита(
		_ЛимитВызовов,
		_ИнтервалЛимита,
		_КоличествоВызововЗаИнтервал,
		ОсталосьОжидать
	);

КонецФункции

Функция СформироватьТекстПревышенияЛимита(КонтекстПревышенияЛимита)

	Возврат СтрШаблон(
		"Превышен лимит вызовов: не более %1 вызовов за %2 мс. Повторите через %3 мс.",
		КонтекстПревышенияЛимита.ЛимитВызовов(),
		КонтекстПревышенияЛимита.ИнтервалЛимита(),
		КонтекстПревышенияЛимита.ОсталосьОжидать()
	);

КонецФункции

Функция ОпределитьОстатокОжидания(ТекущееВремя)
	Возврат (_НачалоИнтервала + _ИнтервалЛимита) - ТекущееВремя;
КонецФункции

Функция ИнтервалМеждуРаспределеннымиВызовами()

	ТочныйИнтервал = _ИнтервалЛимита / _ЛимитВызовов;
	ИнтервалМеждуВызовами = Цел(ТочныйИнтервал);
	Если ИнтервалМеждуВызовами < ТочныйИнтервал Тогда
		ИнтервалМеждуВызовами = ИнтервалМеждуВызовами + 1;
	КонецЕсли;

	Возврат Макс(1, ИнтервалМеждуВызовами);

КонецФункции

Функция НачатыйИнтервалИстек(ТекущееВремя)
	Возврат _НачалоИнтервала <> Неопределено
		И ТекущееВремя - _НачалоИнтервала >= _ИнтервалЛимита;
КонецФункции

Процедура ПроверитьПрерываниеОперации(СигналПрерыванияОперации)

	Если СигналПрерыванияОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СигналПрерыванияОперации.ПроверитьПрерывание();

КонецПроцедуры

Процедура СброситьРасписаниеРавномерногоРаспределения()

	_СледующееРазрешение = 0;

КонецПроцедуры

Процедура СброситьСостояниеОграниченияВызовов()

	СброситьРасписаниеРавномерногоРаспределения();
	_НачалоИнтервала = Неопределено;
	_КоличествоВызововЗаИнтервал = 0;

КонецПроцедуры

Процедура НачатьНовыйИнтервал(ТекущееВремя = Неопределено)

	Если ТекущееВремя = Неопределено Тогда
		ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;

	_НачалоИнтервала = ТекущееВремя;
	_КоличествоВызововЗаИнтервал = 0;
	
	_Лог.Отладка(
		"Начат новый интервал лимита вызовов. Лимит: %1, интервал: %2 мс.",
		_ЛимитВызовов,
		_ИнтервалЛимита
	);

КонецПроцедуры

Процедура ОбновитьИнтервалДляВызоваЕслиНужно(ТекущееВремя)

	Если _НачалоИнтервала = Неопределено
		Или НачатыйИнтервалИстек(ТекущееВремя) Тогда
		НачатьНовыйИнтервал(ТекущееВремя);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
