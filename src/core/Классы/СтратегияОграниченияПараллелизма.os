#Использовать logos

Перем _ЛимитПараллелизма; // Число
Перем _ЛимитОчереди; // Число
Перем _МаксимальноеОжиданиеСлота; // Число
Перем _КоличествоВыполняющихся; // Число
Перем _ОчередьОжидания; // Массив
Перем _ОбработчикПереполнения; // ОбработчикОтказоустойчивости, Неопределено
Перем _БлокировкаРесурса; // БлокировкаРесурса
Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Стратегия ограничения количества одновременно выполняющихся операций.
//
// Параметры:
//   ЛимитПараллелизма - Число - Максимально допустимое количество одновременно выполняющихся операций
//   ЛимитОчереди - Число - Максимально допустимое количество операций, ожидающих свободный слот
Процедура ПриСозданииОбъекта(ЛимитПараллелизма, ЛимитОчереди = 0)

	_КоличествоВыполняющихся = 0;
	_ОчередьОжидания = Новый Массив();
	_МаксимальноеОжиданиеСлота = 0;
	_БлокировкаРесурса = Новый БлокировкаРесурса(ЭтотОбъект);
	_Лог = Логирование.ПолучитьЛог("oscript.lib.resilience.СтратегияОграниченияПараллелизма");

	УстановитьЛимитПараллелизма(ЛимитПараллелизма);
	УстановитьЛимитОчереди(ЛимитОчереди);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет операцию, если есть свободный слот параллелизма.
//
// Параметры:
//   Операция - Действие - Выполняемая операция
//            - ШагПайплайнаОтказоустойчивости - Вложенный шаг пайплайна
//            - Строка - Лямбда-выражение операции
//   Параметры - Массив - Параметры для передачи в операцию
//             - ФиксированныйМассив - Параметры для передачи в операцию
//             - Произвольный - Первый параметр операции
//             - Неопределено - Без параметров
//   СигналПрерыванияОперации - СигналПрерыванияОперации - Сигнал кооперативного прерывания операции
//                            - Неопределено - Без сигнала прерывания
//
// Возвращаемое значение:
//   Произвольный - Результат выполнения операции
Функция Применить(
	Операция,
	Параметры = Неопределено,
	СигналПрерыванияОперации = Неопределено) Экспорт

	АдаптерОперации = Новый АдаптерОперацииОтказоустойчивости();
	ПодготовленнаяОперация = АдаптерОперации.Подготовить(Операция, Параметры);

	Если Не ПопробоватьЗанятьСлот(СигналПрерыванияОперации) Тогда
		КонтекстПереполнения = СоздатьКонтекстПереполнения();
		ОбработатьПереполнение(КонтекстПереполнения);
		ВызватьИсключение СформироватьТекстПереполнения(КонтекстПереполнения);
	КонецЕсли;

	Попытка
		ПроверитьПрерываниеОперации(СигналПрерыванияОперации);
		Результат = ПодготовленнаяОперация.Запустить(СигналПрерыванияОперации);
	Исключение
		ОсвободитьСлот();
		ВызватьИсключение;
	КонецПопытки;

	ОсвободитьСлот();

	Возврат Результат;

КонецФункции

// Устанавливает лимит параллелизма.
//
// Параметры:
//   ЛимитПараллелизма - Число - Максимально допустимое количество одновременно выполняющихся операций
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьЛимитПараллелизма(ЛимитПараллелизма) Экспорт

	Если ЛимитПараллелизма <= 0 Тогда
		ВызватьИсключение "Лимит параллелизма должен быть больше 0.";
	КонецЕсли;

	ОбновитьОграничения(ЛимитПараллелизма);

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает лимит очереди ожидания.
//
// Параметры:
//   ЛимитОчереди - Число - Максимально допустимое количество ожидающих операций
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьЛимитОчереди(ЛимитОчереди) Экспорт

	Если ЛимитОчереди < 0 Тогда
		ВызватьИсключение "Лимит очереди не должен быть меньше 0.";
	КонецЕсли;

	ОбновитьОграничения(Неопределено, ЛимитОчереди);

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает максимальное время ожидания свободного слота.
//
// Параметры:
//   МаксимальноеОжиданиеСлота - Число - Миллисекунд. 0 означает ожидание без ограничения
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьМаксимальноеОжиданиеСлота(МаксимальноеОжиданиеСлота) Экспорт

	Если МаксимальноеОжиданиеСлота < 0 Тогда
		ВызватьИсключение "Максимальное ожидание слота не может быть меньше 0.";
	КонецЕсли;

	ОбновитьОграничения(Неопределено, Неопределено, МаксимальноеОжиданиеСлота);

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает обработчик, который вызывается при переполнении лимита параллелизма.
//
// Параметры:
//   Обработчик - Действие, Строка - Действие или лямбда-выражение, принимающее контекст переполнения
//   ДополнительныеПараметры - Массив - Дополнительные параметры обработчика
//                           - ФиксированныйМассив - Дополнительные параметры обработчика
//                           - Произвольный - Дополнительный параметр обработчика
//                           - Неопределено - Без дополнительных параметров
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьОбработчикПереполнения(Обработчик, ДополнительныеПараметры = Неопределено) Экспорт

	ПодготовленныйОбработчик = Новый ОбработчикОтказоустойчивости(
		Обработчик,
		ДополнительныеПараметры,
		Ложь
	);

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ОбработчикПереполнения = ПодготовленныйОбработчик;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Лимит одновременно выполняющихся операций.
//
// Возвращаемое значение:
//   Число
Функция ЛимитПараллелизма() Экспорт

	СнимокСостояния = СоздатьСнимокСостояния();

	Возврат СнимокСостояния.ЛимитПараллелизма;

КонецФункции

// Лимит очереди ожидания.
//
// Возвращаемое значение:
//   Число
Функция ЛимитОчереди() Экспорт

	СнимокСостояния = СоздатьСнимокСостояния();

	Возврат СнимокСостояния.ЛимитОчереди;

КонецФункции

// Максимальное время ожидания свободного слота.
//
// Возвращаемое значение:
//   Число - Миллисекунд. 0 означает ожидание без ограничения
Функция МаксимальноеОжиданиеСлота() Экспорт

	СнимокСостояния = СоздатьСнимокСостояния();

	Возврат СнимокСостояния.МаксимальноеОжиданиеСлота;

КонецФункции

// Текущее количество выполняющихся операций.
//
// Возвращаемое значение:
//   Число
Функция КоличествоВыполняющихся() Экспорт

	СнимокСостояния = СоздатьСнимокСостояния();

	Возврат СнимокСостояния.КоличествоВыполняющихся;

КонецФункции

// Текущее количество операций, ожидающих свободный слот.
//
// Возвращаемое значение:
//   Число
Функция КоличествоОжидающих() Экспорт

	СнимокСостояния = СоздатьСнимокСостояния();

	Возврат СнимокСостояния.КоличествоОжидающих;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПопробоватьЗанятьСлот(СигналПрерыванияОперации = Неопределено)

	ПроверитьПрерываниеОперации(СигналПрерыванияОперации);

	РезультатПопыткиЗанятьСлот = ПопробоватьЗанятьСлотИлиПоставитьВОжидание(СигналПрерыванияОперации);
	Если РезультатПопыткиЗанятьСлот.Исход = "СлотЗанят" Тогда
		ЛогироватьЗанятыйСлот(РезультатПопыткиЗанятьСлот.СнимокСостояния);
		Возврат Истина;
	КонецЕсли;

	Если РезультатПопыткиЗанятьСлот.Исход = "Отклонено" Тогда
		Возврат Ложь;
	КонецЕсли;

	ЛогироватьПостановкуВОжиданиеСлота(РезультатПопыткиЗанятьСлот.СнимокСостояния);

	ДождатьсяСлотаИлиПрерывания(РезультатПопыткиЗанятьСлот.Ожидание);
	ЛогироватьПолучениеСлотаПослеОжидания();

	Возврат Истина;

КонецФункции

Функция ПопробоватьЗанятьСлотИлиПоставитьВОжидание(СигналПрерыванияОперации)

	РезультатПопыткиЗанятьСлот = СоздатьРезультатПопыткиЗанятьСлот("Отклонено");

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Если МожноЗанятьСлотСразуБезЗахватаБлокировки() Тогда
			ЗанятьСвободныйСлотБезЗахватаБлокировки();
			ЗаполнитьРезультатПопыткиЗанятьСлот(РезультатПопыткиЗанятьСлот, "СлотЗанят");
		ИначеЕсли ЕстьМестоВОчередиОжиданияБезЗахватаБлокировки() Тогда
			Ожидание = СоздатьОжиданиеСлота(СигналПрерыванияОперации);
			ПоставитьОжиданиеВОчередьБезЗахватаБлокировки(Ожидание);
			ЗаполнитьРезультатПопыткиЗанятьСлот(РезультатПопыткиЗанятьСлот, "ПоставленоВОжидание", Ожидание);
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат РезультатПопыткиЗанятьСлот;

КонецФункции

Функция СоздатьРезультатПопыткиЗанятьСлот(Исход, Ожидание = Неопределено)

	РезультатПопыткиЗанятьСлот = Новый Структура();
	РезультатПопыткиЗанятьСлот.Вставить("Исход", Исход);
	РезультатПопыткиЗанятьСлот.Вставить("Ожидание", Ожидание);
	РезультатПопыткиЗанятьСлот.Вставить("СнимокСостояния", Неопределено);

	Возврат РезультатПопыткиЗанятьСлот;

КонецФункции

Процедура ЗаполнитьРезультатПопыткиЗанятьСлот(РезультатПопыткиЗанятьСлот, Исход, Ожидание = Неопределено)

	РезультатПопыткиЗанятьСлот.Исход = Исход;
	РезультатПопыткиЗанятьСлот.Ожидание = Ожидание;
	РезультатПопыткиЗанятьСлот.СнимокСостояния = СоздатьСнимокСостоянияБезЗахватаБлокировки();

КонецПроцедуры

Функция МожноЗанятьСлотСразуБезЗахватаБлокировки()

	Возврат _КоличествоВыполняющихся < _ЛимитПараллелизма И _ОчередьОжидания.Количество() = 0;

КонецФункции

Процедура ЗанятьСвободныйСлотБезЗахватаБлокировки()

	_КоличествоВыполняющихся = _КоличествоВыполняющихся + 1;

КонецПроцедуры

Функция ЕстьМестоВОчередиОжиданияБезЗахватаБлокировки()

	Возврат _ОчередьОжидания.Количество() < _ЛимитОчереди;

КонецФункции

Процедура ПоставитьОжиданиеВОчередьБезЗахватаБлокировки(Ожидание)

	_ОчередьОжидания.Добавить(Ожидание);

КонецПроцедуры

Процедура ДождатьсяСлотаИлиПрерывания(Ожидание)

	Пока Истина Цикл
		Если ПрерываниеОжиданияЗапрошено(Ожидание) Тогда
			Если УдалитьОжиданиеИзОчереди(Ожидание) Тогда
				ПроверитьПрерываниеОжидания(Ожидание);
			КонецЕсли;
		КонецЕсли;

		Если ОжиданиеПолучилоСлот(Ожидание) Тогда
			Прервать;
		КонецЕсли;

		Если МаксимальноеОжиданиеСлотаПревышено(Ожидание) Тогда
			Если УдалитьОжиданиеИзОчереди(Ожидание) Тогда
				ОбработатьПревышениеМаксимальногоОжиданияСлота();
			КонецЕсли;
		КонецЕсли;

		Приостановить(ИнтервалОпросаОжиданияСлота());
	КонецЦикла;

	Если ОжиданиеОтменено(Ожидание) Тогда
		ПроверитьПрерываниеОжидания(Ожидание);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьОжиданиеСлота(СигналПрерыванияОперации)

	Ожидание = Новый Структура();
	Ожидание.Вставить("СигналПрерыванияОперации", СигналПрерыванияОперации);
	Ожидание.Вставить("Отменено", Ложь);
	Ожидание.Вставить("СлотПолучен", Ложь);
	Ожидание.Вставить("МоментНачалаОжидания", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Ожидание.Вставить("МаксимальноеОжиданиеСлота", _МаксимальноеОжиданиеСлота);

	Возврат Ожидание;

КонецФункции

Функция ОжиданиеОтменено(Ожидание)

	Отменено = Ложь;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Отменено = ОжиданиеОтмененоБезЗахватаБлокировки(Ожидание);
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат Отменено;

КонецФункции

Функция ОжиданиеОтмененоБезЗахватаБлокировки(Ожидание)

	Возврат Ожидание.Отменено;

КонецФункции

Функция ОжиданиеПолучилоСлот(Ожидание)

	СлотПолучен = Ложь;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		СлотПолучен = ОжиданиеПолучилоСлотБезЗахватаБлокировки(Ожидание);
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат СлотПолучен;

КонецФункции

Функция ОжиданиеПолучилоСлотБезЗахватаБлокировки(Ожидание)

	Возврат Ожидание.СлотПолучен;

КонецФункции

Функция СигналПрерыванияОжидания(Ожидание)

	Возврат Ожидание.СигналПрерыванияОперации;

КонецФункции

Процедура ЛогироватьЗанятыйСлот(СнимокСостояния)

	_Лог.Отладка(
		"Занят слот параллелизма. Выполняется операций: %1 из %2. Ожидают операций: %3 из %4.",
		СнимокСостояния.КоличествоВыполняющихся,
		СнимокСостояния.ЛимитПараллелизма,
		СнимокСостояния.КоличествоОжидающих,
		СнимокСостояния.ЛимитОчереди
	);

КонецПроцедуры

Процедура ЛогироватьПостановкуВОжиданиеСлота(СнимокСостояния)

	_Лог.Отладка(
		"Операция поставлена в очередь ожидания. Ожидают операций: %1 из %2.",
		СнимокСостояния.КоличествоОжидающих,
		СнимокСостояния.ЛимитОчереди
	);

КонецПроцедуры

Процедура ЛогироватьПолучениеСлотаПослеОжидания()

	СнимокСостояния = СоздатьСнимокСостояния();

	_Лог.Отладка(
		"Операция получила слот после ожидания. Выполняется операций: %1 из %2. Ожидают операций: %3 из %4.",
		СнимокСостояния.КоличествоВыполняющихся,
		СнимокСостояния.ЛимитПараллелизма,
		СнимокСостояния.КоличествоОжидающих,
		СнимокСостояния.ЛимитОчереди
	);

КонецПроцедуры

Функция ПрерываниеОжиданияЗапрошено(Ожидание)

	СигналПрерыванияОперации = СигналПрерыванияОжидания(Ожидание);
	Если СигналПрерыванияОперации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СигналПрерыванияОперации.ПрерываниеЗапрошено();

КонецФункции

Процедура ПроверитьПрерываниеОжидания(Ожидание)

	СигналПрерыванияОперации = СигналПрерыванияОжидания(Ожидание);
	Если СигналПрерыванияОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СигналПрерыванияОперации.ПроверитьПрерывание();

КонецПроцедуры

Функция УдалитьОжиданиеИзОчереди(Ожидание)

	Удалено = Ложь;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Индекс = _ОчередьОжидания.Найти(Ожидание);
		Если Индекс <> Неопределено Тогда
			_ОчередьОжидания.Удалить(Индекс);
			Ожидание.Отменено = Истина;
			Удалено = Истина;
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат Удалено;

КонецФункции

Функция МаксимальноеОжиданиеСлотаПревышено(Ожидание)

	Если Ожидание.МаксимальноеОжиданиеСлота <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - Ожидание.МоментНачалаОжидания
		>= Ожидание.МаксимальноеОжиданиеСлота;

КонецФункции

Процедура ОбработатьПревышениеМаксимальногоОжиданияСлота()

	КонтекстПереполнения = СоздатьКонтекстПереполнения();
	ОбработатьПереполнение(КонтекстПереполнения);

	ВызватьИсключение "Превышено максимальное ожидание слота параллелизма.";

КонецПроцедуры

Функция ИнтервалОпросаОжиданияСлота()

	Возврат 10;

КонецФункции

Процедура ОсвободитьСлот()

	СнимокСостояния = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОсвободитьТекущийСлот();

		СледующееОжидание = ИзвлечьСледующееАктивноеОжидание();
		Если СледующееОжидание <> Неопределено Тогда
			ПередатьСлотОжиданию(СледующееОжидание);
		КонецЕсли;

		СнимокСостояния = СоздатьСнимокСостоянияБезЗахватаБлокировки();
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	_Лог.Отладка(
		"Освобожден слот параллелизма. Выполняется операций: %1 из %2. Ожидают операций: %3 из %4.",
		СнимокСостояния.КоличествоВыполняющихся,
		СнимокСостояния.ЛимитПараллелизма,
		СнимокСостояния.КоличествоОжидающих,
		СнимокСостояния.ЛимитОчереди
	);

КонецПроцедуры

Процедура ОсвободитьТекущийСлот()

	Если _КоличествоВыполняющихся <= 0 Тогда
		ВызватьИсключение "Внутренняя ошибка стратегии ограничения параллелизма: освобождение без занятого слота.";
	КонецЕсли;

	_КоличествоВыполняющихся = _КоличествоВыполняющихся - 1;

КонецПроцедуры

Функция ИзвлечьСледующееАктивноеОжидание()

	Пока _ОчередьОжидания.Количество() > 0 Цикл
		СледующееОжидание = _ОчередьОжидания[0];
		_ОчередьОжидания.Удалить(0);

		Если Не ОжиданиеОтмененоБезЗахватаБлокировки(СледующееОжидание) Тогда
			Возврат СледующееОжидание;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ПередатьСлотОжиданию(Ожидание)

	Ожидание.СлотПолучен = Истина;
	_КоличествоВыполняющихся = _КоличествоВыполняющихся + 1;

КонецПроцедуры

Процедура ОбработатьПереполнение(КонтекстПереполнения)

	ОбработчикПереполнения = ПолучитьОбработчикПереполнения();

	Если ОбработчикПереполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	_Лог.Отладка(
		"Вызывается обработчик переполнения. Выполняется операций: %1 из %2. Ожидают операций: %3 из %4.",
		КонтекстПереполнения.КоличествоВыполняющихся(),
		КонтекстПереполнения.ЛимитПараллелизма(),
		КонтекстПереполнения.КоличествоОжидающих(),
		КонтекстПереполнения.ЛимитОчереди()
	);

	ОбработчикПереполнения.Вызвать(КонтекстПереполнения);

КонецПроцедуры

Функция СоздатьКонтекстПереполнения()

	КонтекстПереполнения = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		КонтекстПереполнения = Новый КонтекстПереполненияПараллелизма(
			_ЛимитПараллелизма,
			_ЛимитОчереди,
			_КоличествоВыполняющихся,
			_ОчередьОжидания.Количество()
		);
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат КонтекстПереполнения;

КонецФункции

Функция СоздатьСнимокСостояния()

	СнимокСостояния = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		СнимокСостояния = СоздатьСнимокСостоянияБезЗахватаБлокировки();
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат СнимокСостояния;

КонецФункции

Функция СоздатьСнимокСостоянияБезЗахватаБлокировки()

	СнимокСостояния = Новый Структура();
	СнимокСостояния.Вставить("ЛимитПараллелизма", _ЛимитПараллелизма);
	СнимокСостояния.Вставить("ЛимитОчереди", _ЛимитОчереди);
	СнимокСостояния.Вставить("МаксимальноеОжиданиеСлота", _МаксимальноеОжиданиеСлота);
	СнимокСостояния.Вставить("КоличествоВыполняющихся", _КоличествоВыполняющихся);
	СнимокСостояния.Вставить("КоличествоОжидающих", _ОчередьОжидания.Количество());

	Возврат СнимокСостояния;

КонецФункции

Функция СформироватьТекстПереполнения(КонтекстПереполнения)

	Если КонтекстПереполнения.ЛимитОчереди() > 0 Тогда
		Возврат СтрШаблон(
			"Превышен лимит параллелизма: выполняется %1 из %2, ожидает %3 из %4.",
			КонтекстПереполнения.КоличествоВыполняющихся(),
			КонтекстПереполнения.ЛимитПараллелизма(),
			КонтекстПереполнения.КоличествоОжидающих(),
			КонтекстПереполнения.ЛимитОчереди()
		);
	КонецЕсли;

	Возврат СтрШаблон(
		"Превышен лимит параллелизма: не более %1 одновременно выполняющихся операций.",
		КонтекстПереполнения.ЛимитПараллелизма()
	);

КонецФункции

Процедура ОбновитьОграничения(
	ЛимитПараллелизма = Неопределено,
	ЛимитОчереди = Неопределено,
	МаксимальноеОжиданиеСлота = Неопределено)

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Если _КоличествоВыполняющихся > 0 Или _ОчередьОжидания.Количество() > 0 Тогда
			ВызватьИсключение "Нельзя менять ограничения параллелизма во время выполнения или ожидания операций.";
		КонецЕсли;

		Если ЛимитПараллелизма <> Неопределено Тогда
			_ЛимитПараллелизма = ЛимитПараллелизма;
		КонецЕсли;

		Если ЛимитОчереди <> Неопределено Тогда
			_ЛимитОчереди = ЛимитОчереди;
		КонецЕсли;

		Если МаксимальноеОжиданиеСлота <> Неопределено Тогда
			_МаксимальноеОжиданиеСлота = МаксимальноеОжиданиеСлота;
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

КонецПроцедуры

Функция ПолучитьОбработчикПереполнения()

	ОбработчикПереполнения = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбработчикПереполнения = _ОбработчикПереполнения;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ОбработчикПереполнения;

КонецФункции

Процедура ПроверитьПрерываниеОперации(СигналПрерыванияОперации)

	Если СигналПрерыванияОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СигналПрерыванияОперации.ПроверитьПрерывание();

КонецПроцедуры

#КонецОбласти
