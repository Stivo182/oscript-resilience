КонецФункции

// Порог успешных пробных вызовов для закрытия предохранителя.
// Закрытие происходит после достижения порога и завершения всех активных допущенных проб.
//
// Возвращаемое значение:
//   Число
Функция ПорогУспешныхПробныхВызововДляЗакрытия() Экспорт

	ПорогУспешныхПробныхВызововДляЗакрытия = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ПорогУспешныхПробныхВызововДляЗакрытия = _ПорогУспешныхПробныхВызововДляЗакрытия;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ПорогУспешныхПробныхВызововДляЗакрытия;

КонецФункции

// Устанавливает количество ошибок подряд до размыкания.
//
// Параметры:
//   ПорогОшибок - Число - Количество ошибок подряд до размыкания
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьПорогОшибок(ПорогОшибок) Экспорт

	Если ПорогОшибок <= 0 Тогда
		ВызватьИсключение "Порог ошибок должен быть больше нуля.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ПорогОшибок = ПорогОшибок;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает длительность размыкания предохранителя.
//
// Параметры:
//   ДлительностьРазмыкания - Число - Миллисекунд до перехода в режим пробной попытки
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьДлительностьРазмыкания(ДлительностьРазмыкания) Экспорт

	Если ДлительностьРазмыкания <= 0 Тогда
		ВызватьИсключение "Длительность размыкания должна быть больше нуля.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ДлительностьРазмыкания = ДлительностьРазмыкания;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает размер окна оценки завершенных вызовов.
//
// Параметры:
//   РазмерОкнаОценки - Число - Количество последних завершенных вызовов для оценки; 0 отключает оконный режим
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьРазмерОкнаОценки(РазмерОкнаОценки) Экспорт

	Если РазмерОкнаОценки < 0 Тогда
		ВызватьИсключение "Размер окна оценки не может быть меньше нуля.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ПроверитьМинимумВызововДляОкнаОценки(РазмерОкнаОценки, _МинимумВызововДляОценки);
		_РазмерОкнаОценки = РазмерОкнаОценки;
		ПодрезатьОкноОценки();
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает минимальное количество вызовов в окне перед оценкой процентов.
//
// Параметры:
//   МинимумВызововДляОценки - Число - Минимальное количество завершенных вызовов для оценки
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьМинимумВызововДляОценки(МинимумВызововДляОценки) Экспорт

	Если МинимумВызововДляОценки < 0 Тогда
		ВызватьИсключение "Минимум вызовов для оценки не может быть меньше нуля.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ПроверитьМинимумВызововДляОкнаОценки(_РазмерОкнаОценки, МинимумВызововДляОценки);
		_МинимумВызововДляОценки = МинимумВызововДляОценки;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает порог процента ошибок в окне оценки.
//
// Параметры:
//   ПорогПроцентаОшибок - Число - Процент ошибок от 1 до 100 включительно
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьПорогПроцентаОшибок(ПорогПроцентаОшибок) Экспорт

	Если ПорогПроцентаОшибок < 1 Или ПорогПроцентаОшибок > 100 Тогда
		ВызватьИсключение "Порог процента ошибок должен быть от 1 до 100.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ПорогПроцентаОшибок = ПорогПроцентаОшибок;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает лимит одновременно выполняющихся пробных вызовов в полуразомкнутом состоянии.
//
// Параметры:
//   ЛимитПробныхВызовов - Число - Максимальное количество активных пробных вызовов
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьЛимитПробныхВызовов(ЛимитПробныхВызовов) Экспорт

	Если ЛимитПробныхВызовов <= 0 Тогда
		ВызватьИсключение "Лимит пробных вызовов должен быть больше нуля.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ЛимитПробныхВызовов = ЛимитПробныхВызовов;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает порог успешных пробных вызовов для закрытия предохранителя.
// Закрытие происходит после достижения порога и завершения всех активных допущенных проб.
//
// Параметры:
//   ПорогУспешныхПробныхВызововДляЗакрытия - Число - Порог успешных актуальных пробных вызовов
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьПорогУспешныхПробныхВызововДляЗакрытия(ПорогУспешныхПробныхВызововДляЗакрытия) Экспорт

	Если ПорогУспешныхПробныхВызововДляЗакрытия <= 0 Тогда
		ВызватьИсключение "Количество успешных пробных вызовов для закрытия должно быть больше нуля.";
	КонецЕсли;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ПорогУспешныхПробныхВызововДляЗакрытия = ПорогУспешныхПробныхВызововДляЗакрытия;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Устанавливает обработчик, который вызывается при размыкании предохранителя.
//
// Параметры:
//   Обработчик - Действие, Строка - Действие или лямбда-выражение, принимающее контекст размыкания
//   ДополнительныеПараметры - Массив - Дополнительные параметры обработчика
//                           - ФиксированныйМассив - Дополнительные параметры обработчика
//                           - Произвольный - Дополнительный параметр обработчика
//                           - Неопределено - Без дополнительных параметров
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция УстановитьОбработчикРазмыкания(Обработчик, ДополнительныеПараметры = Неопределено) Экспорт

	ПодготовленныйОбработчик = Новый ОбработчикОтказоустойчивости(
		Обработчик,
		ДополнительныеПараметры,
		Ложь
	);

	_БлокировкаРесурса.Заблокировать();

	Попытка
		_ОбработчикРазмыкания = ПодготовленныйОбработчик;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ЭтотОбъект;

КонецФункции

// Принудительно возвращает предохранитель в закрытое состояние.
//
// Возвращаемое значение:
//   ЭтотОбъект
Функция Сбросить() Экспорт
	Закрыть();
	_Лог.Отладка("Предохранитель сброшен вручную.");
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьМинимумВызововДляОкнаОценки(РазмерОкнаОценки, МинимумВызововДляОценки)

	Если РазмерОкнаОценки > 0 И МинимумВызововДляОценки > РазмерОкнаОценки Тогда
		ВызватьИсключение "Минимум вызовов для оценки не может быть больше размера окна оценки.";
	КонецЕсли;

КонецПроцедуры

Функция ДопуститьВызов()

	ТекстИсключения = Неопределено;
	КонтекстДопускаВызова = СоздатьКонтекстДопускаВызова();

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ТекущееВремя = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ОбновитьСостояниеЕслиНужно(ТекущееВремя);

		Если _Состояние = СостоянияПредохранителя.Разомкнут Тогда
			ОсталосьОжидать = ОпределитьОсталосьОжидать(ТекущееВремя);
			ТекстИсключения = СтрШаблон(
				"Предохранитель временно разомкнут. Повторите попытку не раньше чем через %1 мс.",
				ОсталосьОжидать
			);
		ИначеЕсли _Состояние = СостоянияПредохранителя.Полуразомкнут Тогда
			Если _АктивныхПробныхВызовов >= _ЛимитПробныхВызовов Тогда
				ТекстИсключения = "Лимит пробных вызовов исчерпан. Дождитесь завершения текущих пробных вызовов.";
			Иначе
				ЗанятьПробныйВызов();
				ЗаполнитьКонтекстДопускаПробногоВызова(КонтекстДопускаВызова);
				_Лог.Отладка("Выдано разрешение на пробный вызов предохранителя.");
			КонецЕсли;
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Если ТекстИсключения <> Неопределено Тогда
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;

	Возврат КонтекстДопускаВызова;

КонецФункции

Функция СоздатьКонтекстДопускаВызова()

	Возврат Новый Структура("ЭтоПробныйВызов, ПоколениеПолуразомкнутогоСостояния", Ложь, Неопределено);

КонецФункции

Процедура ЗаполнитьКонтекстДопускаПробногоВызова(КонтекстДопускаВызова)

	КонтекстДопускаВызова.ЭтоПробныйВызов = Истина;
	КонтекстДопускаВызова.ПоколениеПолуразомкнутогоСостояния = _ПоколениеПолуразомкнутогоСостояния;

КонецПроцедуры

Функция ОбработатьУспех(КонтекстДопускаВызова)

	Если КонтекстДопускаВызова.ЭтоПробныйВызов Тогда
		ЗакрытьПробныйВызовЕслиАктуален(КонтекстДопускаВызова);
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбработатьУспехОбычногоВызова();

КонецФункции

Функция ОбработатьУспехОбычногоВызова()

	РезультатОбработки = СоздатьРезультатБезРазмыкания();
	ДанныеОбработчикаРазмыкания = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Если _Состояние = СостоянияПредохранителя.Закрыт Тогда
			СброситьСчетчикОшибок();
			РезультатОбработки = ОбработатьЗавершенныйВызовВОкне(Истина);

			Если РезультатОбработки.ПредохранительРазомкнут Тогда
				Разомкнуть();
				ДанныеОбработчикаРазмыкания = ПодготовитьДанныеОбработчикаРазмыкания(
					Неопределено,
					РезультатОбработки.ПричинаРазмыкания,
					РезультатОбработки.МетрикиОкнаОценки
				);
			КонецЕсли;
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ДанныеОбработчикаРазмыкания;

КонецФункции

Процедура ОсвободитьПробныйВызовЕслиНужно(КонтекстДопускаВызова)

	Если Не КонтекстДопускаВызова.ЭтоПробныйВызов Тогда
		Возврат;
	КонецЕсли;

	БезопасноОсвободитьПробныйВызовЕслиАктуален(КонтекстДопускаВызова);

КонецПроцедуры

Процедура БезопасноОсвободитьПробныйВызовЕслиАктуален(КонтекстДопускаВызова)

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Если ЭтоАктуальныйПробныйВызов(КонтекстДопускаВызова) Тогда
			ОсвободитьПробныйВызов();
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

КонецПроцедуры

Функция ЭтоАктуальныйПробныйВызов(КонтекстДопускаВызова)

	Возврат КонтекстДопускаВызова.ЭтоПробныйВызов
		И _Состояние = СостоянияПредохранителя.Полуразомкнут
		И КонтекстДопускаВызова.ПоколениеПолуразомкнутогоСостояния = _ПоколениеПолуразомкнутогоСостояния;

КонецФункции

Процедура ОбработатьОшибку(ДанныеОшибки, КонтекстДопускаВызова)

	ДанныеОбработчикаРазмыкания = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		РезультатОбработки = ОбработатьОшибкуПодБлокировкой(КонтекстДопускаВызова);

		Если РезультатОбработки.ПредохранительРазомкнут Тогда
			ДанныеОбработчикаРазмыкания = ПодготовитьДанныеОбработчикаРазмыкания(
				ДанныеОшибки,
				РезультатОбработки.ПричинаРазмыкания,
				РезультатОбработки.МетрикиОкнаОценки
			);
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	ОбработатьРазмыканиеЕслиНужно(ДанныеОбработчикаРазмыкания);

КонецПроцедуры

Функция ПодготовитьДанныеОбработчикаРазмыкания(ДанныеОшибки, ПричинаРазмыкания, МетрикиОкнаОценки)

	Если _ОбработчикРазмыкания = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	КонтекстРазмыкания = Новый КонтекстРазмыканияПредохранителя(
		_ПорогОшибок,
		_КоличествоОшибокПодряд,
		_ДлительностьРазмыкания,
		ДанныеОшибки,
		_Состояние,
		МетрикиОкнаОценки.КоличествоВызововВОкне,
		МетрикиОкнаОценки.КоличествоОшибокВОкне,
		МетрикиОкнаОценки.ПроцентОшибок,
		ПричинаРазмыкания
	);

	Возврат Новый Структура(
		"ОбработчикРазмыкания, КонтекстРазмыкания, СостояниеРазмыкания",
		_ОбработчикРазмыкания,
		КонтекстРазмыкания,
		_Состояние
	);

КонецФункции

Процедура ОбработатьРазмыканиеЕслиНужно(ДанныеОбработчикаРазмыкания)

	Если ДанныеОбработчикаРазмыкания = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбработатьРазмыкание(
		ДанныеОбработчикаРазмыкания.ОбработчикРазмыкания,
		ДанныеОбработчикаРазмыкания.КонтекстРазмыкания,
		ДанныеОбработчикаРазмыкания.СостояниеРазмыкания
	);

КонецПроцедуры

Процедура ОбработатьРазмыкание(ОбработчикРазмыкания, КонтекстРазмыкания, СостояниеРазмыкания)

	_Лог.Отладка(
		"Вызывается обработчик размыкания предохранителя. Состояние: %1.",
		СостояниеРазмыкания
	);

	ОбработчикРазмыкания.Вызвать(КонтекстРазмыкания);

КонецПроцедуры

Функция ОбработатьОшибкуПодБлокировкой(КонтекстДопускаВызова)

	Если КонтекстДопускаВызова.ЭтоПробныйВызов Тогда
		Возврат ОбработатьОшибкуПробногоВызова(КонтекстДопускаВызова);
	КонецЕсли;

	Если _Состояние = СостоянияПредохранителя.Закрыт Тогда
		Возврат ОбработатьОшибкуЗакрытогоПредохранителя();
	КонецЕсли;

	Возврат СоздатьРезультатБезРазмыкания();

КонецФункции

Функция ОбработатьОшибкуПробногоВызова(КонтекстДопускаВызова)

	Если Не ЭтоАктуальныйПробныйВызов(КонтекстДопускаВызова) Тогда
		Возврат СоздатьРезультатБезРазмыкания();
	КонецЕсли;

	Разомкнуть();
	_Лог.Отладка(
		"Пробный вызов завершился ошибкой. Предохранитель снова разомкнут на %1 мс.",
		_ДлительностьРазмыкания
	);

	Возврат СоздатьРезультатРазмыкания(
		ПричиныРазмыканияПредохранителя.ПробныйВызов,
		СоздатьПустыеМетрикиОкнаОценки()
	);

КонецФункции

Функция ОбработатьОшибкуЗакрытогоПредохранителя()

	_КоличествоОшибокПодряд = _КоличествоОшибокПодряд + 1;
	РезультатОконнойОценки = СоздатьРезультатБезРазмыкания();

	Если ОконныйРежимВключен() Тогда
		РезультатОконнойОценки = ОбработатьЗавершенныйВызовВОкне(Ложь);
	КонецЕсли;

	Если _КоличествоОшибокПодряд >= _ПорогОшибок Тогда
		Если _Состояние <> СостоянияПредохранителя.Разомкнут Тогда
			Разомкнуть();
		КонецЕсли;
		_Лог.Отладка(
			"Достигнут порог ошибок (%1). Предохранитель разомкнут на %2 мс.",
			_ПорогОшибок,
			_ДлительностьРазмыкания
		);
		Возврат СоздатьРезультатРазмыкания(
			ПричиныРазмыканияПредохранителя.ПоследовательныеОшибки,
			РезультатОконнойОценки.МетрикиОкнаОценки
		);
	КонецЕсли;

	Если РезультатОконнойОценки.ПредохранительРазомкнут Тогда
		Разомкнуть();
		_Лог.Отладка(
			"Достигнут порог оконной оценки (%1). Предохранитель разомкнут на %2 мс.",
			РезультатОконнойОценки.ПричинаРазмыкания,
			_ДлительностьРазмыкания
		);
		Возврат РезультатОконнойОценки;
	КонецЕсли;

	Если ОконныйРежимВключен() Тогда
		_Лог.Отладка("Зафиксирована ошибка в оконном режиме.");
	Иначе
		_Лог.Отладка(
			"Зафиксирована ошибка. Текущая серия ошибок: %1 из %2.",
			_КоличествоОшибокПодряд,
			_ПорогОшибок
		);
	КонецЕсли;

	Возврат СоздатьРезультатБезРазмыкания();

КонецФункции

Процедура Разомкнуть()

	_Состояние = СостоянияПредохранителя.Разомкнут;
	_РазомкнутДо = ТекущаяУниверсальнаяДатаВМиллисекундах() + _ДлительностьРазмыкания;
	СброситьПробныеВызовы();
	СброситьОкноОценки();

КонецПроцедуры

Процедура ОбновитьСостояниеЕслиНужно(ТекущееВремя)

	Если _Состояние <> СостоянияПредохранителя.Разомкнут Тогда
		Возврат;
	КонецЕсли;

	Если ТекущееВремя < _РазомкнутДо Тогда
		Возврат;
	КонецЕсли;

	ПеревестиВПолуразомкнутоеСостояние();

КонецПроцедуры

Процедура ПеревестиВПолуразомкнутоеСостояние()

	_ПоколениеПолуразомкнутогоСостояния = _ПоколениеПолуразомкнутогоСостояния + 1;
	_Состояние = СостоянияПредохранителя.Полуразомкнут;
	СброситьПробныеВызовы();
	_Лог.Отладка("Предохранитель перешел в состояние пробного вызова.");

КонецПроцедуры

Процедура Закрыть()

	ПредыдущееСостояние = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ПредыдущееСостояние = _Состояние;
		ЗакрытьБезусловноПодБлокировкой();
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	ЛогироватьЗакрытиеЕслиБылПереход(ПредыдущееСостояние);

КонецПроцедуры

Процедура ЗакрытьПробныйВызовЕслиАктуален(КонтекстДопускаВызова)

	ПредыдущееСостояние = Неопределено;
	СостояниеЗакрыто = Ложь;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		Если ЭтоАктуальныйПробныйВызов(КонтекстДопускаВызова) Тогда
			ПредыдущееСостояние = _Состояние;
			ОсвободитьПробныйВызов();
			_УспешныхПробныхВызовов = _УспешныхПробныхВызовов + 1;

			Если _УспешныхПробныхВызовов >= _ПорогУспешныхПробныхВызововДляЗакрытия
				И _АктивныхПробныхВызовов = 0 Тогда
				ЗакрытьБезусловноПодБлокировкой();
				СостояниеЗакрыто = Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Если СостояниеЗакрыто Тогда
		ЛогироватьЗакрытиеЕслиБылПереход(ПредыдущееСостояние);
	КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьБезусловноПодБлокировкой()

	СброситьСчетчикОшибок();
	СброситьОкноОценки();
	_РазомкнутДо = 0;
	_Состояние = СостоянияПредохранителя.Закрыт;
	СброситьПробныеВызовы();

КонецПроцедуры

Процедура ЛогироватьЗакрытиеЕслиБылПереход(ПредыдущееСостояние)

	Если ПредыдущееСостояние <> СостоянияПредохранителя.Закрыт Тогда
		_Лог.Отладка("Предохранитель перешел в закрытое состояние.");
	КонецЕсли;

КонецПроцедуры

Процедура ЗанятьПробныйВызов()

	_АктивныхПробныхВызовов = _АктивныхПробныхВызовов + 1;

КонецПроцедуры

Процедура ОсвободитьПробныйВызов()

	Если _АктивныхПробныхВызовов > 0 Тогда
		_АктивныхПробныхВызовов = _АктивныхПробныхВызовов - 1;
	КонецЕсли;

КонецПроцедуры

Процедура СброситьПробныеВызовы()

	_АктивныхПробныхВызовов = 0;
	_УспешныхПробныхВызовов = 0;

КонецПроцедуры

Процедура СброситьСчетчикОшибок()

	_КоличествоОшибокПодряд = 0;

КонецПроцедуры

Функция ОбработатьЗавершенныйВызовВОкне(Успешно)

	Если Не ОконныйРежимВключен() Тогда
		Возврат СоздатьРезультатБезРазмыкания();
	КонецЕсли;

	ЗафиксироватьЗавершенныйВызовВОкне(Успешно);
	МетрикиОкнаОценки = РассчитатьМетрикиОкнаОценки();

	Если МетрикиОкнаОценки.КоличествоВызововВОкне < _МинимумВызововДляОценки Тогда
		Возврат СоздатьРезультатБезРазмыкания(МетрикиОкнаОценки);
	КонецЕсли;

	Если МетрикиОкнаОценки.КоличествоОшибокВОкне > 0
		И МетрикиОкнаОценки.ПроцентОшибок >= _ПорогПроцентаОшибок Тогда
		Возврат СоздатьРезультатРазмыкания(
			ПричиныРазмыканияПредохранителя.ПроцентОшибок,
			МетрикиОкнаОценки
		);
	КонецЕсли;

	Возврат СоздатьРезультатБезРазмыкания(МетрикиОкнаОценки);

КонецФункции

Процедура ЗафиксироватьЗавершенныйВызовВОкне(Успешно)

	_ОкноОценки.Добавить(Новый Структура("Успешно", Успешно));
	ПодрезатьОкноОценки();

КонецПроцедуры

Процедура ПодрезатьОкноОценки()

	Если _РазмерОкнаОценки = 0 Тогда
		СброситьОкноОценки();
		Возврат;
	КонецЕсли;

	Пока _ОкноОценки.Количество() > _РазмерОкнаОценки Цикл
		_ОкноОценки.Удалить(0);
	КонецЦикла;

КонецПроцедуры

Процедура СброситьОкноОценки()

	_ОкноОценки.Очистить();

КонецПроцедуры

Функция РассчитатьМетрикиОкнаОценки()

	КоличествоВызововВОкне = _ОкноОценки.Количество();
	КоличествоОшибокВОкне = 0;

	Для Каждого РезультатОкна Из _ОкноОценки Цикл
		Если Не РезультатОкна.Успешно Тогда
			КоличествоОшибокВОкне = КоличествоОшибокВОкне + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СоздатьМетрикиОкнаОценки(
		КоличествоВызововВОкне,
		КоличествоОшибокВОкне,
		РассчитатьПроцент(КоличествоОшибокВОкне, КоличествоВызововВОкне)
	);

КонецФункции

Функция РассчитатьПроцент(Часть, Всего)

	Если Всего = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Часть * 100 / Всего;

КонецФункции

Функция СоздатьМетрикиОкнаОценки(
	КоличествоВызововВОкне,
	КоличествоОшибокВОкне,
	ПроцентОшибок)

	Возврат Новый Структура(
		"КоличествоВызововВОкне, КоличествоОшибокВОкне, ПроцентОшибок",
		КоличествоВызововВОкне,
		КоличествоОшибокВОкне,
		ПроцентОшибок
	);

КонецФункции

Функция СоздатьПустыеМетрикиОкнаОценки()

	Возврат СоздатьМетрикиОкнаОценки(0, 0, 0);

КонецФункции

Функция СоздатьРезультатРазмыкания(ПричинаРазмыкания, МетрикиОкнаОценки)

	Возврат Новый Структура(
		"ПредохранительРазомкнут, ПричинаРазмыкания, МетрикиОкнаОценки",
		Истина,
		ПричинаРазмыкания,
		МетрикиОкнаОценки
	);

КонецФункции

Функция СоздатьРезультатБезРазмыкания(МетрикиОкнаОценки = Неопределено)

	Если МетрикиОкнаОценки = Неопределено Тогда
		МетрикиОкнаОценки = СоздатьПустыеМетрикиОкнаОценки();
	КонецЕсли;

	Возврат Новый Структура(
		"ПредохранительРазомкнут, ПричинаРазмыкания, МетрикиОкнаОценки",
		Ложь,
		Неопределено,
		МетрикиОкнаОценки
	);

КонецФункции

Функция ОконныйРежимВключен()

	Возврат _РазмерОкнаОценки > 0;

КонецФункции

Функция ОпределитьОсталосьОжидать(ТекущееВремя)
	Возврат Макс(0, _РазомкнутДо - ТекущееВремя);
КонецФункции

#КонецОбласти
