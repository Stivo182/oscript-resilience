#Использовать logos

Перем _ПорогОшибок; // Число
Перем _ДлительностьРазмыкания; // Число
Перем _КоличествоОшибокПодряд; // Число
Перем _РазомкнутДо; // Число
Перем _Состояние; // Строка - см. СостоянияПредохранителя
Перем _РазмерОкнаОценки; // Число
Перем _МинимумВызововДляОценки; // Число
Перем _ПорогПроцентаОшибок; // Число
Перем _ОкноОценки; // Массив
Перем _ЛимитПробныхВызовов; // Число
Перем _ПорогУспешныхПробныхВызововДляЗакрытия; // Число
Перем _АктивныхПробныхВызовов; // Число
Перем _УспешныхПробныхВызовов; // Число
Перем _ПоколениеПолуразомкнутогоСостояния; // Число
Перем _ОбработчикРазмыкания; // ОбработчикОтказоустойчивости, Неопределено
Перем _БлокировкаРесурса; // БлокировкаРесурса
Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Стратегия предохранителя с порогом ошибок и временем размыкания.
//
// Параметры:
//   ПорогОшибок - Число - Количество ошибок подряд до размыкания
//   ДлительностьРазмыкания - Число - Миллисекунд до перехода в режим пробной попытки
Процедура ПриСозданииОбъекта(ПорогОшибок = 5, ДлительностьРазмыкания = 30000)

	_КоличествоОшибокПодряд = 0;
	_РазомкнутДо = 0;
	_Состояние = СостоянияПредохранителя.Закрыт;
	_РазмерОкнаОценки = 0;
	_МинимумВызововДляОценки = 0;
	_ПорогПроцентаОшибок = 100;
	_ОкноОценки = Новый Массив();
	_ЛимитПробныхВызовов = 1;
	_ПорогУспешныхПробныхВызововДляЗакрытия = 1;
	_АктивныхПробныхВызовов = 0;
	_УспешныхПробныхВызовов = 0;
	_ПоколениеПолуразомкнутогоСостояния = 0;
	_ОбработчикРазмыкания = Неопределено;
	_БлокировкаРесурса = Новый БлокировкаРесурса(ЭтотОбъект);
	_Лог = Логирование.ПолучитьЛог("oscript.lib.resilience.СтратегияПредохранителя");

	УстановитьПорогОшибок(ПорогОшибок);
	УстановитьДлительностьРазмыкания(ДлительностьРазмыкания);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет операцию с учетом текущего состояния предохранителя.
//
// Параметры:
//   Операция - Действие - Выполняемая операция
//            - ШагПайплайнаОтказоустойчивости - Вложенный шаг пайплайна
//            - Строка - Лямбда-выражение операции
//   Параметры - Массив - Параметры для передачи в операцию
//             - ФиксированныйМассив - Параметры для передачи в операцию
//             - Произвольный - Первый параметр операции
//             - Неопределено - Без параметров
//   СигналПрерыванияОперации - СигналПрерыванияОперации - Сигнал кооперативного прерывания операции
//                            - Неопределено - Без сигнала прерывания
//
// Возвращаемое значение:
//   Произвольный - Результат выполнения операции
Функция Применить(
	Операция,
	Параметры = Неопределено,
	СигналПрерыванияОперации = Неопределено) Экспорт

	АдаптерОперации = Новый АдаптерОперацииОтказоустойчивости();
	ПодготовленнаяОперация = АдаптерОперации.Подготовить(Операция, Параметры);
	КонтекстДопускаВызова = ДопуститьВызов();
	ДанныеОбработчикаРазмыкания = Неопределено;

	Если СигналПрерыванияОперации <> Неопределено Тогда
		Попытка
			СигналПрерыванияОперации.ПроверитьПрерывание();
		Исключение
			ОсвободитьПробныйВызовЕслиНужно(КонтекстДопускаВызова);
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;

	Попытка
		Результат = ПодготовленнаяОперация.Запустить(СигналПрерыванияОперации);
	Исключение
		ОбработатьОшибку(ИнформацияОбОшибке(), КонтекстДопускаВызова);
		ВызватьИсключение;
	КонецПопытки;

	ДанныеОбработчикаРазмыкания = ОбработатьУспех(КонтекстДопускаВызова);
	ОбработатьРазмыканиеЕслиНужно(ДанныеОбработчикаРазмыкания);

	Возврат Результат;

КонецФункции

// Текущее состояние предохранителя.
//
// Возвращаемое значение:
//   Строка - см. СостоянияПредохранителя
Функция Состояние() Экспорт

	ТекущееСостояние = Неопределено;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ОбновитьСостояниеЕслиНужно(ТекущаяУниверсальнаяДатаВМиллисекундах());
		ТекущееСостояние = _Состояние;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ТекущееСостояние;

КонецФункции

// Количество ошибок подряд до размыкания.
//
// Возвращаемое значение:
//   Число
Функция ПорогОшибок() Экспорт

	ПорогОшибок = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ПорогОшибок = _ПорогОшибок;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ПорогОшибок;

КонецФункции

// Длительность размыкания.
//
// Возвращаемое значение:
//   Число - Миллисекунд
Функция ДлительностьРазмыкания() Экспорт

	ДлительностьРазмыкания = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ДлительностьРазмыкания = _ДлительностьРазмыкания;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат ДлительностьРазмыкания;

КонецФункции

// Количество подряд идущих ошибок.
//
// Возвращаемое значение:
//   Число
Функция КоличествоОшибокПодряд() Экспорт

	КоличествоОшибок = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		КоличествоОшибок = _КоличествоОшибокПодряд;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат КоличествоОшибок;

КонецФункции

// Размер окна оценки завершенных вызовов.
//
// Возвращаемое значение:
//   Число
Функция РазмерОкнаОценки() Экспорт

	РазмерОкнаОценки = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		РазмерОкнаОценки = _РазмерОкнаОценки;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат РазмерОкнаОценки;

КонецФункции

// Минимальное количество вызовов в окне перед оценкой процентов.
//
// Возвращаемое значение:
//   Число
Функция МинимумВызововДляОценки() Экспорт

	МинимумВызововДляОценки = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		МинимумВызововДляОценки = _МинимумВызововДляОценки;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

	Возврат МинимумВызововДляОценки;

КонецФункции

// Порог процента ошибок в окне оценки.
//
// Возвращаемое значение:
//   Число
Функция ПорогПроцентаОшибок() Экспорт

	ПорогПроцентаОшибок = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ПорогПроцентаОшибок = _ПорогПроцентаОшибок;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
