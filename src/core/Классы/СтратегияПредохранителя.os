КонецФункции

// Лимит одновременно выполняющихся пробных вызовов.
//
// Возвращаемое значение:
//   Число
Функция ЛимитПробныхВызовов() Экспорт

	ЛимитПробныхВызовов = 0;

	_БлокировкаРесурса.Заблокировать();

	Попытка
		ЛимитПробныхВызовов = _ЛимитПробныхВызовов;
	Исключение
		_БлокировкаРесурса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаРесурса.Разблокировать();

