#Область ПрограммныйИнтерфейс

// Возвращает код превышения времени выполнения операции.
//
// Возвращаемое значение:
//   Строка
Функция ПревышениеТаймаута() Экспорт
	Возврат "resilience.timeout.exceeded";
КонецФункции

// Возвращает код отклонения операции ограничителем вызовов.
//
// Возвращаемое значение:
//   Строка
Функция ОтклонениеПоОграничениюВызовов() Экспорт
	Возврат "resilience.rate_limit.rejected";
КонецФункции

// Возвращает код отклонения операции ограничителем параллелизма.
//
// Возвращаемое значение:
//   Строка
Функция ОтклонениеПоОграничениюПараллелизма() Экспорт
	Возврат "resilience.parallelism.rejected";
КонецФункции

// Возвращает код превышения времени ожидания слота параллелизма.
//
// Возвращаемое значение:
//   Строка
Функция ПревышениеОжиданияСлотаПараллелизма() Экспорт
	Возврат "resilience.parallelism.wait_timeout";
КонецФункции

// Возвращает код освобождения незанятого слота параллелизма.
//
// Возвращаемое значение:
//   Строка
Функция ОсвобождениеНезанятогоСлота() Экспорт
	Возврат "resilience.parallelism.slot_not_acquired";
КонецФункции

// Возвращает код отклонения изменения ограничений параллелизма.
//
// Возвращаемое значение:
//   Строка
Функция ОтклонениеИзмененияОграниченийПараллелизма() Экспорт
	Возврат "resilience.parallelism.configuration_change_rejected";
КонецФункции

// Возвращает код ошибки разомкнутого предохранителя.
//
// Возвращаемое значение:
//   Строка
Функция РазомкнутыйПредохранитель() Экспорт
	Возврат "resilience.circuit.open";
КонецФункции

// Возвращает код отмены операции по сигналу.
//
// Возвращаемое значение:
//   Строка
Функция ОтменаОперации() Экспорт
	Возврат "resilience.operation.cancelled";
КонецФункции

#КонецОбласти
