#Область СлужебныйПрограммныйИнтерфейс

// Приостанавливает выполнение и периодически проверяет сигнал прерывания.
//
// Параметры:
//   Задержка - Число - Длительность ожидания в миллисекундах
//   СигналПрерыванияОперации - СигналПрерыванияОперации, Неопределено - Сигнал кооперативного прерывания
//   ИнтервалОпроса - Число - Максимальный интервал между проверками сигнала.
//                            Неположительное значение ограничивается снизу до 1 мс
Процедура ПриостановитьСПроверкойПрерывания(
	Задержка,
	СигналПрерыванияОперации = Неопределено,
	ИнтервалОпроса = 10) Экспорт

	Если Задержка <= 0 Тогда
		Возврат;
	КонецЕсли;

	Если СигналПрерыванияОперации = Неопределено Тогда
		Приостановить(Задержка);
		Возврат;
	КонецЕсли;

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока Истина Цикл
		Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
		Если Прошло >= Задержка Тогда
			Прервать;
		КонецЕсли;

		СигналПрерыванияОперации.ПроверитьПрерывание();

		Осталось = Задержка - Прошло;
		Приостановить(Мин(Макс(1, ИнтервалОпроса), Макс(1, Осталось)));
	КонецЦикла;

	СигналПрерыванияОперации.ПроверитьПрерывание();

КонецПроцедуры

#КонецОбласти
