#Область Тесты

&Тест
Процедура ТестДолжен_ВозвращатьсяСразуПриНулевойЗадержке() Экспорт

	// Подготовка
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Действие
	ОжиданиеОтказоустойчивости.ПриостановитьСПроверкойПрерывания(0);

	// Проверка
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	Ожидаем.Что(Прошло, "Нулевая задержка должна возвращаться сразу").Меньше(50);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОжидатьЗаданнуюЗадержкуБезСигнала() Экспорт

	// Подготовка
	Задержка = 50;
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Действие
	ОжиданиеОтказоустойчивости.ПриостановитьСПроверкойПрерывания(Задержка);

	// Проверка
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	Ожидаем.Что(Прошло, "Ожидание должно продолжаться не меньше заданной задержки").БольшеИлиРавно(Задержка);
	Ожидаем.Что(Прошло, "Ожидание не должно существенно превышать заданную задержку").Меньше(500);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрерыватьОжиданиеПослеЗапросаСигнала() Экспорт

	// Подготовка
	Задержка = 500;
	ИнтервалОпроса = 10;
	ДопустимоеВремяПослеПрерывания = ИнтервалОпроса + 200;
	ПричинаПрерывания = "Остановлено тестом.";
	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();

	// Действие
	Задача = ФоновыеЗадания.Выполнить(
		ОжиданиеОтказоустойчивости,
		"ПриостановитьСПроверкойПрерывания",
		ПараметрыОжидания(Задержка, СигналПрерыванияОперации, ИнтервалОпроса)
	);

	ФоновоеОжиданиеНачалось = Не Задача.ОжидатьЗавершения(50);
	МоментЗапросаПрерывания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СигналПрерыванияОперации.ЗапроситьПрерывание(ПричинаПрерывания);
	ФоновоеОжиданиеЗавершилось = Задача.ОжидатьЗавершения(1000);
	ПрошлоПослеПрерывания = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапросаПрерывания;

	// Проверка
	Ожидаем.Что(ФоновоеОжиданиеНачалось, "Фоновое ожидание должно начаться до запроса прерывания").ЭтоИстина();
	Ожидаем.Что(ФоновоеОжиданиеЗавершилось, "Фоновое ожидание должно завершиться после запроса прерывания").ЭтоИстина();
	Ожидаем
		.Что(ПрошлоПослеПрерывания, "Ожидание должно завершиться быстро после запроса прерывания")
		.МеньшеИлиРавно(ДопустимоеВремяПослеПрерывания);
	Ожидаем.Что(
		КраткоеПредставлениеОшибки(Задача.ИнформацияОбОшибке),
		"Текст ошибки должен содержать причину прерывания"
	).Содержит(ПричинаПрерывания);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрерыватьОжиданиеДляУжеЗапрошенногоСигнала() Экспорт

	// Подготовка
	Задержка = 500;
	ПричинаПрерывания = "Остановлено тестом.";
	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();
	СигналПрерыванияОперации.ЗапроситьПрерывание(ПричинаПрерывания);
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Действие и Проверка
	Ожидаем
		.Что(ОжиданиеОтказоустойчивости, "Вызов ожидания должен выбрасывать ожидаемое исключение")
		.Метод(
			"ПриостановитьСПроверкойПрерывания",
			ПараметрыОжидания(Задержка, СигналПрерыванияОперации)
		)
		.ВыбрасываетИсключение(ПричинаПрерывания);

	// Проверка
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	Ожидаем.Что(Прошло, "Уже запрошенное прерывание должно обрабатываться сразу").Меньше(100);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьсяСразуПриОтрицательнойЗадержке() Экспорт

	// Подготовка
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Действие
	ОжиданиеОтказоустойчивости.ПриостановитьСПроверкойПрерывания(-1);

	// Проверка
	Прошло = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	Ожидаем.Что(Прошло, "Отрицательная задержка должна возвращаться сразу").Меньше(50);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрерыватьОжиданиеПриНеположительномИнтервалеОпроса() Экспорт

	// Подготовка
	Задержка = 500;
	ИнтервалОпроса = 0;
	ДопустимоеВремяПослеПрерывания = 200;
	ПричинаПрерывания = "Остановлено тестом.";
	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();

	// Действие
	Задача = ФоновыеЗадания.Выполнить(
		ОжиданиеОтказоустойчивости,
		"ПриостановитьСПроверкойПрерывания",
		ПараметрыОжидания(Задержка, СигналПрерыванияОперации, ИнтервалОпроса)
	);

	ФоновоеОжиданиеНачалось = Не Задача.ОжидатьЗавершения(50);
	МоментЗапросаПрерывания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	СигналПрерыванияОперации.ЗапроситьПрерывание(ПричинаПрерывания);
	ФоновоеОжиданиеЗавершилось = Задача.ОжидатьЗавершения(1000);
	ПрошлоПослеПрерывания = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментЗапросаПрерывания;

	// Проверка
	Ожидаем.Что(ФоновоеОжиданиеНачалось, "Фоновое ожидание должно начаться до запроса прерывания").ЭтоИстина();
	Ожидаем.Что(ФоновоеОжиданиеЗавершилось, "Фоновое ожидание должно завершиться после запроса прерывания").ЭтоИстина();
	Ожидаем
		.Что(ПрошлоПослеПрерывания, "Неположительный интервал опроса должен ограничиваться снизу")
		.МеньшеИлиРавно(ДопустимоеВремяПослеПрерывания);
	Ожидаем.Что(
		КраткоеПредставлениеОшибки(Задача.ИнформацияОбОшибке),
		"Текст ошибки должен содержать причину прерывания"
	).Содержит(ПричинаПрерывания);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыОжидания(Задержка, СигналПрерыванияОперации = Неопределено, ИнтервалОпроса = 10)

	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить(Задержка);
	ПараметрыМетода.Добавить(СигналПрерыванияОперации);
	ПараметрыМетода.Добавить(ИнтервалОпроса);

	Возврат ПараметрыМетода;

КонецФункции

#КонецОбласти
