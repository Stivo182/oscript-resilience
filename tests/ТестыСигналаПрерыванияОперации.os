#Область Тесты

&Тест
Процедура ТестДолжен_ВозвращатьНеопределеноЕслиСрокНеУстановлен() Экспорт

	// Подготовка
	Сигнал = Новый СигналПрерыванияОперации();

	// Действие
	ОсталосьВремени = Сигнал.ОсталосьВремени();

	// Проверка
	Ожидаем.Что(ОсталосьВремени, "Без срока не должно быть ограничения времени").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонятьОтрицательныйСрок() Экспорт

	// Подготовка
	Сигнал = Новый СигналПрерыванияОперации();

	// Действие
	Ошибка = Неопределено;
	Попытка
		Сигнал.УстановитьСрок(-1);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКодОшибки(Ошибка, КодыСтандартныхОшибок.АргументВнеДиапазона());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьОставшеесяВремяДоСрока() Экспорт

	// Подготовка
	Сигнал = Новый СигналПрерыванияОперации();
	Сигнал.УстановитьСрок(10000);

	// Действие
	ОсталосьВремени = Сигнал.ОсталосьВремени();

	// Проверка
	Ожидаем.Что(ОсталосьВремени <> Неопределено, "Срок должен быть установлен").ЭтоИстина();
	Ожидаем.Что(ОсталосьВремени, "Остаток не должен превышать срок").МеньшеИлиРавно(10000);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрерыватьОперациюПослеИстеченияСрока() Экспорт

	// Подготовка
	Сигнал = Новый СигналПрерыванияОперации();
	Сигнал.УстановитьСрок(0);

	// Действие
	Ошибка = Неопределено;
	Попытка
		Сигнал.ПроверитьПрерывание();
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Сигнал.ПрерываниеЗапрошено(), "После срока должно быть запрошено прерывание").ЭтоИстина();
	Ожидаем.Что(Сигнал.ПричинаПрерывания(), "Причина должна описывать срок").Равно("Истек срок операции: 0 мс.");
	Ожидаем.Что(Сигнал.ОсталосьВремени(), "После срока не должно оставаться времени").Равно(0);
	ПроверитьКодОшибки(Ошибка, КодыОшибокОтказоустойчивости.ПревышениеСрокаОперации());

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПереноситьИстекшийСрок() Экспорт

	// Подготовка
	Сигнал = Новый СигналПрерыванияОперации();
	Сигнал.УстановитьСрок(0);

	// Действие
	Сигнал.УстановитьСрок(10000);

	// Проверка
	Ожидаем.Что(Сигнал.ОсталосьВремени(), "Истекший срок нельзя перенести").Равно(0);
	Ожидаем.Что(Сигнал.ПричинаПрерывания(), "Первая причина должна сохраниться").Равно("Истек срок операции: 0 мс.");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКодОшибки(Ошибка, ОжидаемыйКод)

	Ожидаем.Что(Ошибка <> Неопределено, "Ожидалось исключение").ЭтоИстина();
	КодОшибки = ДиагностикаОшибок.Разобрать(Ошибка).КодОшибки();
	Ожидаем.Что(КодОшибки, "Код ошибки должен совпадать с ожидаемым").Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти
