&Тест
Процедура ТестДолжен_НеВызыватьУсловиеЗапасногоСценарияПриУспешнойОперации() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	ОсновнойСценарий.УстановитьРезультат("main");
	Операция = Новый Действие(ОсновнойСценарий, "Успех");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Условие = Новый ТестовыеДействияОтказоустойчивости();

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	).УстановитьУсловиеЗапасногоСценария(
		Новый Действие(Условие, "РазрешитьЗапаснойСценарий")
	);

	// Действие
	Результат = Стратегия.Применить(Операция);

	// Проверка
	Ожидаем.Что(Результат, "Должен вернуться результат основной операции").Равно("main");
	Ожидаем.Что(Условие.СчетчикВызовов(), "Условие не должно вызываться без ошибки").Равно(0);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий не должен запускаться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьУсловиеЗапасногоСценарияДляУжеПрерваннойОперации() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	ОсновнаяОперация = Новый Действие(ОсновнойСценарий, "ВсегдаОшибка");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Условие = Новый ТестовыеДействияОтказоустойчивости();

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	).УстановитьУсловиеЗапасногоСценария(
		Новый Действие(Условие, "РазрешитьЗапаснойСценарий")
	);

	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();
	СигналПрерыванияОперации.ЗапроситьПрерывание("Остановлено тестом.");

	// Действие и Проверка
	Ожидаем
		.Что(Стратегия, "Прерывание не должно вызывать условие запасного сценария")
		.Метод(
			"Применить",
			ПомощникТестирования.ПараметрыИсполнения(ОсновнаяОперация, Неопределено, СигналПрерыванияОперации)
		)
		.ВыбрасываетИсключение("Остановлено тестом.");

	Ожидаем.Что(ОсновнойСценарий.СчетчикВызовов(), "Основная операция не должна запускаться").Равно(0);
	Ожидаем.Что(Условие.СчетчикВызовов(), "Условие не должно вызываться после прерывания").Равно(0);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий не должен запускаться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВызыватьУсловиеЗапасногоСценарияЕслиОсновнаяОперацияПрервана() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(ОсновнойСценарий, "ЗапроситьПрерываниеИВыброситьИсключение");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Условие = Новый ТестовыеДействияОтказоустойчивости();

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	).УстановитьУсловиеЗапасногоСценария(
		Новый Действие(Условие, "РазрешитьЗапаснойСценарий")
	);

	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();

	// Действие и Проверка
	Ожидаем
		.Что(Стратегия, "Прерывание основной операции не должно вызывать условие запасного сценария")
		.Метод(
			"Применить",
			ПомощникТестирования.ПараметрыИсполнения(Операция, СигналПрерыванияОперации, СигналПрерыванияОперации)
		)
		.ВыбрасываетИсключение("Остановлено тестом.");

	Ожидаем.Что(ОсновнойСценарий.СчетчикВызовов(), "Основная операция должна быть запущена").Равно(1);
	Ожидаем.Что(Условие.СчетчикВызовов(), "Условие не должно вызываться после прерывания").Равно(0);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий не должен запускаться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьУсловиеЗапасногоСценарияНаМоментЗапуска() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(ОсновнойСценарий, "ЗаменитьУсловиеЗапасногоСценарияИВыброситьИсключение");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	ЗапаснойСценарий.УстановитьРезультат("fallback");

	ИсходноеУсловие = Новый ТестовыеДействияОтказоустойчивости();
	НовоеУсловие = Новый ТестовыеДействияОтказоустойчивости();

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	).УстановитьУсловиеЗапасногоСценария(
		Новый Действие(ИсходноеУсловие, "РазрешитьЗапаснойСценарий")
	);

	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить(Стратегия);
	ПараметрыОперации.Добавить(
		Новый Действие(НовоеУсловие, "ЗапретитьЗапаснойСценарий")
	);

	// Действие
	Результат = Стратегия.Применить(Операция, ПараметрыОперации);

	// Проверка
	Ожидаем.Что(Результат, "Должно использоваться условие на момент запуска стратегии").Равно("fallback");
	Ожидаем.Что(ИсходноеУсловие.СчетчикВызовов(), "Исходное условие должно быть вызвано").Равно(1);
	Ожидаем.Что(НовоеУсловие.СчетчикВызовов(), "Новое условие не должно использоваться в текущем запуске").Равно(0);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий должен выполниться").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыполнятьЗапаснойСценарийЕслиОсновнаяОперацияПрервана() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(ОсновнойСценарий, "ЗапроситьПрерываниеИВыброситьИсключение");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	ЗапаснойСценарий.УстановитьРезультат("fallback");

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	);

	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();

	// Действие и Проверка
	Ожидаем
		.Что(Стратегия, "Прерывание не должно превращаться в fallback-результат")
		.Метод(
			"Применить",
			ПомощникТестирования.ПараметрыИсполнения(Операция, СигналПрерыванияОперации, СигналПрерыванияОперации)
		)
		.ВыбрасываетИсключение("Остановлено тестом.");

	Ожидаем.Что(ОсновнойСценарий.СчетчикВызовов(), "Основная операция должна быть запущена").Равно(1);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий не должен запускаться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыполнятьЗапаснойСценарийДляУжеПрерваннойОперации() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	ОсновнаяОперация = Новый Действие(ОсновнойСценарий, "ВсегдаОшибка");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	);

	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();
	СигналПрерыванияОперации.ЗапроситьПрерывание("Остановлено тестом.");

	// Действие и Проверка
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод(
			"Применить",
			ПомощникТестирования.ПараметрыИсполнения(ОсновнаяОперация, Неопределено, СигналПрерыванияОперации)
		)
		.ВыбрасываетИсключение("Остановлено тестом.");

	Ожидаем.Что(ОсновнойСценарий.СчетчикВызовов(), "Основная операция не должна запускаться").Равно(0);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий не должен запускаться").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьОбработчикЗапасногоСценарияНаМоментЗапуска() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(ОсновнойСценарий, "ЗаменитьОбработчикСтратегииИВыброситьИсключение");

	ИсходныйЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	ИсходныйЗапаснойСценарий.УстановитьРезультат("исходный");

	НовыйЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	НовыйЗапаснойСценарий.УстановитьРезультат("новый");

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ИсходныйЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	);

	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить(Стратегия);
	ПараметрыОперации.Добавить(
		Новый Действие(НовыйЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	);

	// Действие
	Результат = Стратегия.Применить(Операция, ПараметрыОперации);

	// Проверка
	Ожидаем.Что(Результат, "Должен использоваться обработчик на момент запуска стратегии").Равно("исходный");
	Ожидаем.Что(ОсновнойСценарий.СчетчикВызовов(), "Основная операция должна выполниться один раз").Равно(1);
	Ожидаем.Что(ИсходныйЗапаснойСценарий.СчетчикВызовов(), "Исходный запасной сценарий должен запускаться").Равно(1);
	Ожидаем.Что(НовыйЗапаснойСценарий.СчетчикВызовов(), "Новый запасной сценарий не должен запускаться").Равно(0);

КонецПроцедуры

#КонецОбласти
