&Тест
Процедура ТестДолжен_ВыполнятьЗапаснойСценарийЕслиУсловиеРазрешает() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(ОсновнойСценарий, "ВсегдаОшибка");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	ЗапаснойСценарий.УстановитьРезультат("fallback");

	Условие = Новый ТестовыеДействияОтказоустойчивости();

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	).УстановитьУсловиеЗапасногоСценария(
		Новый Действие(Условие, "РазрешитьЗапаснойСценарий")
	);

	// Действие
	Результат = Стратегия.Применить(Операция);

	// Проверка
	Ожидаем.Что(Результат, "Запасной сценарий должен вернуть результат").Равно("fallback");
	Ожидаем.Что(Условие.СчетчикВызовов(), "Условие должно быть вызвано один раз").Равно(1);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий должен выполниться").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПробрасыватьОшибкуЕслиУсловиеЗапасногоСценарияНеРазрешает() Экспорт

	// Подготовка
	ОсновнойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(ОсновнойСценарий, "ВсегдаОшибкаСПараметрами");

	ЗапаснойСценарий = Новый ТестовыеДействияОтказоустойчивости();
	Условие = Новый ТестовыеДействияОтказоустойчивости();

	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить("left");
	ПараметрыОперации.Добавить("right");

	Стратегия = Новый СтратегияЗапасногоСценария(
		Новый Действие(ЗапаснойСценарий, "УспехСКонтекстомОшибкиЗапасногоСценария")
	).УстановитьУсловиеЗапасногоСценария(
		Новый Действие(Условие, "ЗапретитьЗапаснойСценарий")
	);

	// Действие и Проверка
	Ожидаем
		.Что(Стратегия, "Запрещенный запасной сценарий должен пробросить исходную ошибку")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(Операция, ПараметрыОперации))
		.ВыбрасываетИсключение("Всегда ошибка с параметрами: left, right.");

	Ожидаем.Что(Условие.СчетчикВызовов(), "Условие должно быть вызвано один раз").Равно(1);
	Ожидаем.Что(ЗапаснойСценарий.СчетчикВызовов(), "Запасной сценарий не должен запускаться").Равно(0);

КонецПроцедуры

