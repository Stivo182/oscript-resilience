&Тест
Процедура ТестДолжен_ВалидироватьПараметрыОграниченияВызовов() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(1, 1000);

	ПараметрыЛимитаВызовов = Новый Массив();
	ПараметрыЛимитаВызовов.Добавить(0);

	ПараметрыИнтервалаЛимита = Новый Массив();
	ПараметрыИнтервалаЛимита.Добавить(0);

	ПараметрыМаксимальногоОжидания = Новый Массив();
	ПараметрыМаксимальногоОжидания.Добавить(-1);

	ПараметрыТипаОграничения = Новый Массив();
	ПараметрыТипаОграничения.Добавить("НеизвестныйТип");

	// Действие и Проверка
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("УстановитьЛимитВызовов", ПараметрыЛимитаВызовов)
		.ВыбрасываетИсключение("Лимит вызовов должен быть больше 0.");

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("УстановитьИнтервалЛимита", ПараметрыИнтервалаЛимита)
		.ВыбрасываетИсключение("Интервал лимита должен быть больше 0 мс.");

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("УстановитьМаксимальноеОжиданиеРазрешения", ПараметрыМаксимальногоОжидания)
		.ВыбрасываетИсключение("Максимальное ожидание разрешения не может быть меньше 0.");

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("УстановитьТипОграничения", ПараметрыТипаОграничения)
		.ВыбрасываетИсключение("Неизвестный тип ограничения вызовов: НеизвестныйТип");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВозвращатьКоличествоВызововЗаТекущийИнтервал() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(2, 120);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	НачальноеКоличествоВызовов = Стратегия.КоличествоВызововЗаИнтервал();
	Стратегия.Применить(Операция);
	КоличествоПослеПервогоВызова = Стратегия.КоличествоВызововЗаИнтервал();
	Стратегия.Применить(Операция);
	КоличествоПослеВторогоВызова = Стратегия.КоличествоВызововЗаИнтервал();

	Приостановить(140);
	КоличествоПослеИстеченияИнтервала = Стратегия.КоличествоВызововЗаИнтервал();

	// Проверка
	Ожидаем.Что(НачальноеКоличествоВызовов, "Значение должно быть равно 0").Равно(0);
	Ожидаем.Что(КоличествоПослеПервогоВызова, "Значение должно быть равно 1").Равно(1);
	Ожидаем.Что(КоличествоПослеВторогоВызова, "Значение должно быть равно 2").Равно(2);
	Ожидаем.Что(КоличествоПослеИстеченияИнтервала, "Значение должно быть равно 0").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеНачинатьИнтервалПриЧтенииКоличествоВызововДоПервогоВызова() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(1, 2000);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	КоличествоДоВызова = Стратегия.КоличествоВызововЗаИнтервал();
	Приостановить(1500);
	Стратегия.Применить(Операция);
	Приостановить(700);

	Ожидаем
		.Что(Стратегия, "Второй реальный вызов должен попадать в тот же интервал")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(Операция))
		.ВыбрасываетИсключение("Превышен лимит вызовов");

	// Проверка
	Ожидаем.Что(КоличествоДоВызова, "Чтение до первого вызова должно вернуть 0").Равно(0);
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Должен выполниться только первый реальный вызов").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеНачинатьИнтервалПриЧтенииКоличествоВызововПослеИстеченияИнтервала() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(1, 500);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	Стратегия.Применить(Операция);
	Приостановить(550);

	// Действие
	КоличествоПослеИстеченияИнтервала = Стратегия.КоличествоВызововЗаИнтервал();
	Приостановить(300);
	Стратегия.Применить(Операция);
	Приостановить(250);

	// Проверка
	Ожидаем
		.Что(Стратегия, "Следующий вызов должен оставаться в интервале второго реального вызова")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(Операция))
		.ВыбрасываетИсключение("Превышен лимит вызовов");

	Ожидаем.Что(КоличествоПослеИстеченияИнтервала, "Чтение после истечения интервала должно вернуть 0").Равно(0);
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Должны выполниться первый вызов и первый вызов нового интервала").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СбрасыватьТекущееСостояниеЛимитаПоМетодуСбросить() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(1, 1000);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	Стратегия.Применить(Операция);
	КоличествоДоСброса = Стратегия.КоличествоВызововЗаИнтервал();
	Стратегия.Сбросить();
	КоличествоПослеСброса = Стратегия.КоличествоВызововЗаИнтервал();
	РезультатПослеСброса = Стратегия.Применить(Операция);

	// Проверка
	Ожидаем.Что(КоличествоДоСброса, "Значение должно быть равно 1").Равно(1);
	Ожидаем.Что(КоличествоПослеСброса, "Значение должно быть равно 0").Равно(0);
	Ожидаем.Что(РезультатПослеСброса, "Результат должен быть равен ожидаемому значению").Равно("ok");
	Ожидаем.Что(Стратегия.КоличествоВызововЗаИнтервал(), "Количество вызовов за интервал должно быть равно 1").Равно(1);
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Счетчик вызовов должен быть равен 2").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОжидатьСвободноеРазрешениеЕслиОжиданиеУкладываетсяВЛимит() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(1, 120)
		.УстановитьМаксимальноеОжиданиеРазрешения(180);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	ПервыйРезультат = Стратегия.Применить(Операция);
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВторойРезультат = Стратегия.Применить(Операция);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;

	// Проверка
	Ожидаем.Что(ПервыйРезультат, "Первый вызов должен вернуть ожидаемый результат").Равно("ok");
	Ожидаем.Что(ВторойРезультат, "Второй вызов должен вернуть ожидаемый результат").Равно("ok");
	Ожидаем.Что(Длительность, "Второй вызов должен дождаться следующего окна").БольшеИлиРавно(80);
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Оба вызова должны быть выполнены").Равно(2);

КонецПроцедуры

&Тест
&Параметры(1, 500, 50, Ложь, "Вызов должен быть отклонен, если ждать слишком долго")
&Параметры(2, 200, 30, Истина, "Вызов должен быть отклонен, если ближайшее разрешение равномерного распределения слишком далеко")
Процедура ТестДолжен_ОтклонятьВызовЕслиОжиданиеРазрешенияПревышаетЛимит(
	ЛимитВызовов,
	ИнтервалЛимита,
	МаксимальноеОжиданиеРазрешения,
	ИспользоватьРавномерноеРаспределение,
	СообщениеПроверки) Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(ЛимитВызовов, ИнтервалЛимита)
		.УстановитьМаксимальноеОжиданиеРазрешения(МаксимальноеОжиданиеРазрешения);

	Если ИспользоватьРавномерноеРаспределение Тогда
		Стратегия.УстановитьТипОграничения(ТипыОграниченияВызовов.РавномерноеРаспределение);
	КонецЕсли;

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	Стратегия.Применить(Операция);

	// Проверка
	Ожидаем
		.Что(Стратегия, СообщениеПроверки)
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(Операция))
		.ВыбрасываетИсключение("Превышен лимит вызовов");
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Второй вызов не должен запускать операцию").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспределятьВызовыРавномерноВПределахИнтервала() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(10, 2000)
		.УстановитьТипОграничения(ТипыОграниченияВызовов.РавномерноеРаспределение)
		.УстановитьМаксимальноеОжиданиеРазрешения(1000);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	ПервыйРезультат = Стратегия.Применить(Операция);
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВторойРезультат = Стратегия.Применить(Операция);
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;

	// Проверка
	Ожидаем.Что(ПервыйРезультат, "Первый вызов должен вернуть ожидаемый результат").Равно("ok");
	Ожидаем.Что(ВторойРезультат, "Второй вызов должен вернуть ожидаемый результат").Равно("ok");
	Ожидаем.Что(Длительность, "В режиме равномерного распределения второй вызов должен ждать примерно половину интервала").БольшеИлиРавно(40);
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Оба вызова должны быть выполнены").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УчитыватьВызовыРавномерногоРаспределенияВКоличествеВызововЗаИнтервал() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(2, 120)
		.УстановитьТипОграничения(ТипыОграниченияВызовов.РавномерноеРаспределение)
		.УстановитьМаксимальноеОжиданиеРазрешения(100);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	Стратегия.Применить(Операция);
	Стратегия.Применить(Операция);

	// Проверка
	Ожидаем
		.Что(Стратегия.КоличествоВызововЗаИнтервал(), "Вызовы равномерного распределения должны учитываться в текущем интервале")
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаспределятьВызовыСОкруглениемВверхДляНеделимогоИнтервала() Экспорт

	// Подготовка
	КоличествоВызовов = 300;
	Стратегия = Новый СтратегияОграниченияВызовов(КоличествоВызовов, 601)
		.УстановитьТипОграничения(ТипыОграниченияВызовов.РавномерноеРаспределение)
		.УстановитьМаксимальноеОжиданиеРазрешения(10);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");

	// Действие
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Для НомерВызова = 1 По КоличествоВызовов Цикл
		ПоследнийРезультат = Стратегия.Применить(Операция);
	КонецЦикла;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;

	// Проверка
	Ожидаем.Что(ПоследнийРезультат, "Последний вызов должен вернуть ожидаемый результат").Равно("ok");
	Ожидаем
		.Что(Длительность, "Неделимый интервал равномерного распределения должен округляться вверх")
		.БольшеИлиРавно(750);
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Все вызовы должны быть выполнены").Равно(КоличествоВызовов);

