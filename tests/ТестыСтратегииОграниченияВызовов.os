Процедура ТестДолжен_НеУдерживатьРазрешениеРавномерногоРаспределенияПослеПрерыванияОжидания() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияВызовов(2, 1000)
		.УстановитьТипОграничения(ТипыОграниченияВызовов.РавномерноеРаспределение)
		.УстановитьМаксимальноеОжиданиеРазрешения(800);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Операция = Новый Действие(Сценарий, "Успех");
	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();

	// Действие
	ПервыйРезультат = Стратегия.Применить(Операция);
	Задача = ФоновыеЗадания.Выполнить(
		Стратегия,
		"Применить",
		ПомощникТестирования.ПараметрыИсполнения(Операция, Неопределено, СигналПрерыванияОперации)
	);

	ФоновоеОжиданиеНачалось = Не Задача.ОжидатьЗавершения(50);
	СигналПрерыванияОперации.ЗапроситьПрерывание("Остановлено тестом.");
	ФоновоеОжиданиеЗавершилось = Задача.ОжидатьЗавершения(1000);

	СледующийРезультат = Стратегия.Применить(Операция);

	// Проверка
	Ожидаем.Что(ПервыйРезультат, "Первый вызов должен вернуть ожидаемый результат").Равно("ok");
	Ожидаем.Что(ФоновоеОжиданиеНачалось, "Фоновая операция должна начать ожидание разрешения").ЭтоИстина();
	Ожидаем.Что(ФоновоеОжиданиеЗавершилось, "Фоновая операция должна завершиться после прерывания").ЭтоИстина();
	Ожидаем.Что(
		КраткоеПредставлениеОшибки(Задача.ИнформацияОбОшибке),
		"Текст ошибки должен содержать причину прерывания"
	).Содержит("Остановлено тестом.");
	Ожидаем.Что(СледующийРезультат, "Следующий вызов должен вернуть ожидаемый результат").Равно("ok");
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Прерванная операция не должна запускаться").Равно(2);

КонецПроцедуры

