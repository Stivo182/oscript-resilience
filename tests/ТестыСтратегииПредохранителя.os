&Тест
Процедура ТестДолжен_РазмыкатьПредохранительПоПроцентуОшибокПослеМинимальногоЧислаВызовов() Экспорт

	// Подготовка
	Колбэки = Новый ТестовыеКолбэкиПредохранителя();

	Стратегия = СоздатьОконнуюСтратегию(Колбэки, 4, 4, 50);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");

	// Действие
	Ожидаем
		.Что(Стратегия, "Первый вызов должен завершиться ошибкой")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	ПервыйУспешныйРезультат = Стратегия.Применить(ОперацияУспеха);

	Ожидаем
		.Что(Стратегия, "Третий вызов должен завершиться ошибкой")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	ВторойУспешныйРезультат = Стратегия.Применить(ОперацияУспеха);

	// Проверка
	Ожидаем.Что(ПервыйУспешныйРезультат, "Первый успешный вызов должен вернуть результат").Равно("ok");
	Ожидаем.Что(ВторойУспешныйРезультат, "Второй успешный вызов должен вернуть результат").Равно("ok");
	Ожидаем
		.Что(Стратегия.Состояние(), "Предохранитель должен разомкнуться после заполнения окна")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем.Что(Колбэки.ПорогиОшибок().Количество(), "Обработчик размыкания должен быть вызван один раз").Равно(1);
	Ожидаем.Что(Колбэки.КоличествоВызововВОкне()[0], "В окне должно быть четыре вызова").Равно(4);
	Ожидаем.Что(Колбэки.КоличествоОшибокВОкне()[0], "В окне должно быть две ошибки").Равно(2);
	Ожидаем.Что(Колбэки.ПроцентыОшибок()[0], "Процент ошибок должен быть равен 50").Равно(50);
	Ожидаем.Что(Колбэки.ЕстьДанныеОшибки()[0], "Размыкание после успешного вызова не должно содержать данные ошибки").ЭтоЛожь();
	Ожидаем.Что(Колбэки.ПричиныРазмыкания()[0], "Причина размыкания должна быть процентом ошибок")
		.Равно(ПричиныРазмыканияПредохранителя.ПроцентОшибок);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередаватьДанныеОшибкиПриОконномРазмыканииНаОшибочномВызове() Экспорт

	// Подготовка
	Колбэки = Новый ТестовыеКолбэкиПредохранителя();

	Стратегия = СоздатьОконнуюСтратегию(Колбэки, 2, 2, 50);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");

	// Действие
	УспешныйРезультат = Стратегия.Применить(ОперацияУспеха);

	Ожидаем
		.Что(Стратегия, "Второй вызов должен завершиться ошибкой и разомкнуть предохранитель по окну")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	// Проверка
	Ожидаем.Что(УспешныйРезультат, "Первый успешный вызов должен вернуть результат").Равно("ok");
	Ожидаем.Что(Стратегия.Состояние(), "Предохранитель должен разомкнуться по оконной оценке")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем.Что(Колбэки.ПорогиОшибок().Количество(), "Обработчик размыкания должен быть вызван один раз").Равно(1);
	Ожидаем.Что(Колбэки.КоличествоВызововВОкне()[0], "В окне должно быть два вызова").Равно(2);
	Ожидаем.Что(Колбэки.КоличествоОшибокВОкне()[0], "В окне должна быть одна ошибка").Равно(1);
	Ожидаем.Что(Колбэки.ПроцентыОшибок()[0], "Процент ошибок должен быть равен 50").Равно(50);
	Ожидаем.Что(Колбэки.ЕстьДанныеОшибки()[0], "Размыкание на ошибочном вызове должно содержать данные ошибки").ЭтоИстина();
	Ожидаем.Что(Колбэки.ПричиныРазмыкания()[0], "Причина размыкания должна быть процентом ошибок")
		.Равно(ПричиныРазмыканияПредохранителя.ПроцентОшибок);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОцениватьПроцентОшибокТолькоПоПоследнимВызовамВОкне() Экспорт

	// Подготовка
	Колбэки = Новый ТестовыеКолбэкиПредохранителя();

	Стратегия = Новый СтратегияПредохранителя(10, 1000)
		.УстановитьРазмерОкнаОценки(3)
		.УстановитьМинимумВызововДляОценки(3)
		.УстановитьПорогПроцентаОшибок(61)
		.УстановитьОбработчикРазмыкания(Новый Действие(Колбэки, "ПослеРазмыкания"));

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");

	// Действие
	ПервыйУспешныйРезультат = Стратегия.Применить(ОперацияУспеха);
	ВторойУспешныйРезультат = Стратегия.Применить(ОперацияУспеха);

	Ожидаем
		.Что(Стратегия, "Третий вызов должен завершиться ошибкой")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	СостояниеПослеПервойОшибки = Стратегия.Состояние();

	Ожидаем
		.Что(Стратегия, "Четвертый вызов должен завершиться ошибкой и разомкнуть предохранитель")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	// Проверка
	Ожидаем.Что(ПервыйУспешныйРезультат, "Первый успешный вызов должен вернуть результат").Равно("ok");
	Ожидаем.Что(ВторойУспешныйРезультат, "Второй успешный вызов должен вернуть результат").Равно("ok");
	Ожидаем.Что(СостояниеПослеПервойОшибки, "Первые три вызова не должны размыкать предохранитель")
		.Равно(СостоянияПредохранителя.Закрыт);
	Ожидаем
		.Что(Стратегия.Состояние(), "Предохранитель должен разомкнуться по последним трем вызовам окна")
		.Равно(СостоянияПредохранителя.Разомкнут);
