		"Порог процента ошибок должен быть от 1 до 100."
	);
	ПроверитьВалидациюПараметра(
		Стратегия,
		"УстановитьЛимитПробныхВызовов",
		0,
		"Лимит пробных вызовов должен быть больше нуля",
		"Лимит пробных вызовов должен быть больше нуля."
	);
	ПроверитьВалидациюПараметра(
		Стратегия,
		"УстановитьПорогУспешныхПробныхВызововДляЗакрытия",
		0,
		"Порог успешных пробных вызовов должен быть больше нуля",
		"Количество успешных пробных вызовов для закрытия должно быть больше нуля."
	);

