#Область Тесты

&Тест
Процедура ТестДолжен_ПереводитьПредохранительВРазомкнутоеСостояниеИБлокироватьВызовы() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(2, 200);
	
	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Сценарий.УстановитьОшибокДоУспеха(10);
	Операция = Новый Действие(Сценарий, "Нестабильное");

	// Действие
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(Операция))
		.ВыбрасываетИсключение("Ошибка на попытке");

	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Закрыт);

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(Операция))
		.ВыбрасываетИсключение("Ошибка на попытке");

	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(Операция))
		.ВыбрасываетИсключение("Предохранитель временно разомкнут");

	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);

	// Проверка
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Счетчик вызовов должен быть равен 2").Равно(2);
	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Полуразомкнут);

КонецПроцедуры

&Тест
Процедура ТестДолжен_БлокироватьВторойВызовВПолуразомкнутомСостоянииПокаИдетПробный() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 120);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	СценарийОшибки.УстановитьОшибокДоУспеха(10);
	ОперацияОшибки = Новый Действие(СценарийОшибки, "Нестабильное");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ВложеннаяОперация = Новый Действие(СценарийУспеха, "Успех");
	ПробноеДействие = Новый ТестовоеДействиеСВложеннымВызовомПредохранителя(Стратегия, ВложеннаяОперация);
	ОперацияПробы = Новый Действие(ПробноеДействие, "ВыполнитьСВложеннымЗапуском");

	// Действие
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Ошибка на попытке");

	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);

	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);

	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Полуразомкнут);

	Результат = Стратегия.Применить(ОперацияПробы);

	// Проверка
	Ожидаем.Что(Результат, "Результат должен быть равен ожидаемому значению").Равно("ok");
	Ожидаем.Что(ПробноеДействие.ВнутреннийСбойПойман(), "Внутренняя ошибка должна быть обработана").ЭтоИстина();
	Ожидаем.Что(СценарийУспеха.СчетчикВызовов(), "Счетчик вызовов должен быть равен 0").Равно(0);
	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Закрыт);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакрыватьПредохранительПослеУспешнойПробнойПопытки() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 100);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");

	// Действие
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);

	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);

	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Полуразомкнут);

	Результат = Стратегия.Применить(ОперацияУспеха);

	// Проверка
	Ожидаем.Что(Результат, "Результат должен быть равен ожидаемому значению").Равно("ok");
	Ожидаем.Что(СценарийУспеха.СчетчикВызовов(), "Счетчик вызовов должен быть равен 1").Равно(1);
	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Закрыт);
	Ожидаем.Что(Стратегия.КоличествоОшибокПодряд(), "Количество ошибок подряд должно быть равно 0").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакрыватьПредохранительПослеНесколькихУспешныхПробныхВызовов() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 100)
		.УстановитьЛимитПробныхВызовов(2)
		.УстановитьПорогУспешныхПробныхВызововДляЗакрытия(2);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийПервойПробы = Новый ТестовоеУправляемоеДействие();
	ОперацияПервойПробы = Новый Действие(СценарийПервойПробы, "ВыполнитьУправляемо");

	СценарийВторойПробы = Новый ТестовоеУправляемоеДействие();
	ОперацияВторойПробы = Новый Действие(СценарийВторойПробы, "ВыполнитьУправляемо");

	СценарийТретьейПробы = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияТретьейПробы = Новый Действие(СценарийТретьейПробы, "Успех");

	// Действие
	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Первый сбой должен разомкнуть предохранитель"
	);

	ЗадачаПервойПробы = ЗапуститьПробныйВызовВФоне(Стратегия, ОперацияПервойПробы);
	ЗадачаВторойПробы = ЗапуститьПробныйВызовВФоне(Стратегия, ОперацияВторойПробы);

	ПерваяПробаНачалась = ДождатьсяНачалаДействия(СценарийПервойПробы);
	ВтораяПробаНачалась = ДождатьсяНачалаДействия(СценарийВторойПробы);

	Ожидаем
		.Что(Стратегия, "Третий пробный вызов должен быть отклонен по лимиту")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияТретьейПробы))
		.ВыбрасываетИсключение("Лимит пробных вызовов исчерпан");

	СценарийПервойПробы.Разрешить();
	ПерваяПробаЗавершилась = ЗадачаПервойПробы.ОжидатьЗавершения(5000);
	СостояниеПослеПервойПробы = Стратегия.Состояние();

	СценарийВторойПробы.Разрешить();
	ВтораяПробаЗавершилась = ЗадачаВторойПробы.ОжидатьЗавершения(5000);

	// Проверка
	Ожидаем.Что(ПерваяПробаНачалась, "Первая проба должна начаться").ЭтоИстина();
	Ожидаем.Что(ВтораяПробаНачалась, "Вторая проба должна начаться").ЭтоИстина();
	Ожидаем.Что(ПерваяПробаЗавершилась, "Первая проба должна завершиться").ЭтоИстина();
	Ожидаем.Что(ВтораяПробаЗавершилась, "Вторая проба должна завершиться").ЭтоИстина();
	Ожидаем.Что(ЗадачаПервойПробы.ИнформацияОбОшибке = Неопределено, "Первая проба должна завершиться успешно").ЭтоИстина();
	Ожидаем.Что(ЗадачаВторойПробы.ИнформацияОбОшибке = Неопределено, "Вторая проба должна завершиться успешно").ЭтоИстина();
	Ожидаем.Что(СостояниеПослеПервойПробы, "Одного успешного пробного вызова должно быть недостаточно для закрытия")
		.Равно(СостоянияПредохранителя.Полуразомкнут);
	Ожидаем.Что(СценарийТретьейПробы.СчетчикВызовов(), "Отклоненная третья проба не должна запускать операцию").Равно(0);
	Ожидаем
		.Что(Стратегия.Состояние(), "Предохранитель должен закрыться после двух успешных проб")
		.Равно(СостоянияПредохранителя.Закрыт);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НакапливатьУспешныеПробыЕслиПорогБольшеЛимитаПробныхВызовов() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 100)
		.УстановитьЛимитПробныхВызовов(1)
		.УстановитьПорогУспешныхПробныхВызововДляЗакрытия(2);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");

	// Действие
	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Первый сбой должен разомкнуть предохранитель"
	);

	ПервыйРезультат = Стратегия.Применить(ОперацияУспеха);
	СостояниеПослеПервойПробы = Стратегия.Состояние();
	ВторойРезультат = Стратегия.Применить(ОперацияУспеха);

	// Проверка
	Ожидаем.Что(ПервыйРезультат, "Первый пробный вызов должен вернуть результат").Равно("ok");
	Ожидаем.Что(ВторойРезультат, "Второй пробный вызов должен вернуть результат").Равно("ok");
	Ожидаем.Что(СостояниеПослеПервойПробы, "Одного успешного пробного вызова должно быть недостаточно")
		.Равно(СостоянияПредохранителя.Полуразомкнут);
	Ожидаем.Что(Стратегия.Состояние(), "Предохранитель должен закрыться после достижения порога")
		.Равно(СостоянияПредохранителя.Закрыт);
	Ожидаем.Что(СценарийУспеха.СчетчикВызовов(), "Должны выполниться две успешные пробы").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СбрасыватьНакопленныеУспешныеПробыПослеОшибочнойПробы() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 100)
		.УстановитьЛимитПробныхВызовов(1)
		.УстановитьПорогУспешныхПробныхВызововДляЗакрытия(2);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");

	// Действие
	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Первый сбой должен разомкнуть предохранитель"
	);

	ПервыйРезультат = Стратегия.Применить(ОперацияУспеха);
	СостояниеПослеПервойПробы = Стратегия.Состояние();

	Ожидаем
		.Что(Стратегия, "Ошибочная проба должна снова разомкнуть предохранитель")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);

	ВторойРезультат = Стратегия.Применить(ОперацияУспеха);
	СостояниеПослеПервойПробыПослеОшибки = Стратегия.Состояние();
	ТретийРезультат = Стратегия.Применить(ОперацияУспеха);

	// Проверка
	Ожидаем.Что(ПервыйРезультат, "Первая успешная проба должна вернуть результат").Равно("ok");
	Ожидаем.Что(ВторойРезультат, "Первая проба после повторного размыкания должна вернуть результат").Равно("ok");
	Ожидаем.Что(ТретийРезультат, "Вторая проба после повторного размыкания должна вернуть результат").Равно("ok");
	Ожидаем.Что(СостояниеПослеПервойПробы, "Первой успешной пробы должно быть недостаточно")
		.Равно(СостоянияПредохранителя.Полуразомкнут);
	Ожидаем
		.Что(СостояниеПослеПервойПробыПослеОшибки, "После ошибочной пробы накопленные успехи должны быть сброшены")
		.Равно(СостоянияПредохранителя.Полуразомкнут);
	Ожидаем.Что(Стратегия.Состояние(), "После повторного набора полного порога предохранитель должен закрыться")
		.Равно(СостоянияПредохранителя.Закрыт);
	Ожидаем.Что(СценарийУспеха.СчетчикВызовов(), "Должны выполниться три успешные пробы").Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗакрыватьПредохранительПокаЕстьАктивныеДопущенныеПробы() Экспорт

	// Подготовка
	Колбэки = Новый ТестовыеКолбэкиПредохранителя();

	Стратегия = Новый СтратегияПредохранителя(1, 100)
		.УстановитьЛимитПробныхВызовов(2)
		.УстановитьПорогУспешныхПробныхВызововДляЗакрытия(1)
		.УстановитьОбработчикРазмыкания(Новый Действие(Колбэки, "ПослеРазмыкания"));

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспешнойПробы = Новый ТестовоеУправляемоеДействие();
	ОперацияУспешнойПробы = Новый Действие(СценарийУспешнойПробы, "ВыполнитьУправляемо");

	СценарийОшибочнойПробы = Новый ТестовоеУправляемоеДействие();
	ОперацияОшибочнойПробы = Новый Действие(СценарийОшибочнойПробы, "ВыполнитьУправляемоСОшибкой");

	// Действие
	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Первый сбой должен разомкнуть предохранитель"
	);

	ЗадачаУспешнойПробы = ЗапуститьПробныйВызовВФоне(Стратегия, ОперацияУспешнойПробы);
	ЗадачаОшибочнойПробы = ЗапуститьПробныйВызовВФоне(Стратегия, ОперацияОшибочнойПробы);

	УспешнаяПробаНачалась = ДождатьсяНачалаДействия(СценарийУспешнойПробы);
	ОшибочнаяПробаНачалась = ДождатьсяНачалаДействия(СценарийОшибочнойПробы);

	СценарийУспешнойПробы.Разрешить();
	УспешнаяПробаЗавершилась = ЗадачаУспешнойПробы.ОжидатьЗавершения(5000);
	СостояниеПослеУспешнойПробы = Стратегия.Состояние();

	СценарийОшибочнойПробы.Разрешить();
	ОшибочнаяПробаЗавершилась = ЗадачаОшибочнойПробы.ОжидатьЗавершения(5000);

	// Проверка
	Ожидаем.Что(УспешнаяПробаНачалась, "Успешная проба должна начаться").ЭтоИстина();
	Ожидаем.Что(ОшибочнаяПробаНачалась, "Ошибочная проба должна начаться").ЭтоИстина();
	Ожидаем.Что(УспешнаяПробаЗавершилась, "Успешная проба должна завершиться").ЭтоИстина();
	Ожидаем.Что(ОшибочнаяПробаЗавершилась, "Ошибочная проба должна завершиться").ЭтоИстина();
	Ожидаем.Что(ЗадачаУспешнойПробы.ИнформацияОбОшибке = Неопределено, "Первая проба должна завершиться успешно").ЭтоИстина();
	Ожидаем.Что(ЗадачаОшибочнойПробы.ИнформацияОбОшибке <> Неопределено, "Вторая проба должна завершиться ошибкой").ЭтоИстина();
	Ожидаем
		.Что(СостояниеПослеУспешнойПробы, "Успех одной пробы не должен закрывать предохранитель при активной второй пробе")
		.Равно(СостоянияПредохранителя.Полуразомкнут);
	Ожидаем
		.Что(Стратегия.Состояние(), "Ошибка активной допущенной пробы должна снова разомкнуть предохранитель")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем.Что(Колбэки.ПричиныРазмыкания().Количество(), "Должны быть зафиксированы первичное и повторное размыкания").Равно(2);
	Ожидаем.Что(Колбэки.ПричиныРазмыкания()[0], "Первое размыкание должно быть вызвано ошибками подряд")
		.Равно(ПричиныРазмыканияПредохранителя.ПоследовательныеОшибки);
	Ожидаем.Что(Колбэки.ПричиныРазмыкания()[1], "Повторное размыкание должно быть вызвано ошибкой пробного вызова")
		.Равно(ПричиныРазмыканияПредохранителя.ПробныйВызов);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрименятьУстановленныеПараметрыПредохранителя() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя()
		.УстановитьПорогОшибок(2)
		.УстановитьДлительностьРазмыкания(150)
		.УстановитьРазмерОкнаОценки(5)
		.УстановитьМинимумВызововДляОценки(3)
		.УстановитьПорогПроцентаОшибок(60)
		.УстановитьЛимитПробныхВызовов(2)
		.УстановитьПорогУспешныхПробныхВызововДляЗакрытия(2);

	// Проверка
	Ожидаем.Что(Стратегия.ПорогОшибок(), "Порог ошибок должен быть равен 2").Равно(2);
	Ожидаем.Что(Стратегия.ДлительностьРазмыкания(), "Длительность размыкания должна быть равна 150").Равно(150);
	Ожидаем.Что(Стратегия.РазмерОкнаОценки(), "Размер окна оценки должен быть равен 5").Равно(5);
	Ожидаем.Что(Стратегия.МинимумВызововДляОценки(), "Минимум вызовов для оценки должен быть равен 3").Равно(3);
	Ожидаем.Что(Стратегия.ПорогПроцентаОшибок(), "Порог процента ошибок должен быть равен 60").Равно(60);
	Ожидаем.Что(Стратегия.ЛимитПробныхВызовов(), "Лимит пробных вызовов должен быть равен 2").Равно(2);
	Ожидаем
		.Что(
			Стратегия.ПорогУспешныхПробныхВызововДляЗакрытия(),
			"Порог успешных пробных вызовов должен быть равен 2"
		)
		.Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВалидироватьПараметрыПредохранителя() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя();

	ПараметрыПорога = Новый Массив();
	ПараметрыПорога.Добавить(0);

	ПараметрыРазмыкания = Новый Массив();
	ПараметрыРазмыкания.Добавить(0);

	// Действие и Проверка
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("УстановитьПорогОшибок", ПараметрыПорога)
		.ВыбрасываетИсключение("Порог ошибок должен быть больше нуля.");

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("УстановитьДлительностьРазмыкания", ПараметрыРазмыкания)
		.ВыбрасываетИсключение("Длительность размыкания должна быть больше нуля.");

КонецПроцедуры

