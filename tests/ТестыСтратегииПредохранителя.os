&Тест
Процедура ТестДолжен_ВызыватьОбработчикРазмыканияПриДостиженииПорогаОшибок() Экспорт

	// Подготовка
	Колбэки = Новый ТестовыеКолбэкиПредохранителя();

	Стратегия = Новый СтратегияПредохранителя(2, 180);
	Стратегия.УстановитьОбработчикРазмыкания(Новый Действие(Колбэки, "ПослеРазмыкания"));

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	СценарийОшибки.УстановитьОшибокДоУспеха(10);
	ОперацияОшибки = Новый Действие(СценарийОшибки, "Нестабильное");

	// Действие
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Ошибка на попытке");

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Ошибка на попытке");

	// Проверка
	Ожидаем.Что(Колбэки.ПорогиОшибок().Количество(), "Количество порогов ошибок должно быть равно 1").Равно(1);
	Ожидаем.Что(Колбэки.ПорогиОшибок()[0], "Порог ошибок должен быть равен 2").Равно(2);
	Ожидаем.Что(Колбэки.КоличествоОшибокПодряд()[0], "Количество ошибок подряд должно быть равно 2").Равно(2);
	Ожидаем.Что(Колбэки.ДлительностиРазмыкания()[0], "Длительность размыкания должна быть равна 180").Равно(180);
	Ожидаем
		.Что(Колбэки.Состояния()[0], "Значение должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем.Что(Колбэки.ЕстьДанныеОшибки()[0], "Признак наличия данных об ошибке должен быть истинным").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоддерживатьСтроковуюЛямбдуДляОбработчикаРазмыкания() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 100);
	Стратегия.УстановитьОбработчикРазмыкания("(Контекст) -> ВызватьИсключение ""Обработчик размыкания вызван""");

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	// Действие
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Обработчик размыкания вызван");

	// Проверка
	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередаватьДополнительныеПараметрыВДелегатОбработчикаРазмыкания() Экспорт

	// Подготовка
	Колбэки = Новый ТестовыеКолбэкиПредохранителя();

	Стратегия = Новый СтратегияПредохранителя(1, 100);
	Стратегия.УстановитьОбработчикРазмыкания(
		Новый Действие(Колбэки, "ПослеРазмыканияСМаркером"),
		"marker"
	);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	// Действие
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	// Проверка
	Ожидаем.Что(Колбэки.Маркеры().Количество(), "Количество маркеров должно быть равно 1").Равно(1);
	Ожидаем.Что(Колбэки.Маркеры()[0], "Маркер должен быть равен ожидаемому значению").Равно("marker");

