	Ожидаем.Что(ЗадачаПозднейОшибки.ИнформацияОбОшибке <> Неопределено, "Обычный вызов должен завершиться ошибкой").ЭтоИстина();
	Ожидаем.Что(Стратегия.Состояние(), "Поздняя ошибка обычного вызова не должна считаться ошибкой пробного вызова")
		.Равно(СостоянияПредохранителя.Полуразомкнут);

