&Тест
Процедура ТестДолжен_УчитыватьПрерываниеПоТаймаутуКакОшибкуПредохранителя() Экспорт

	// Подготовка
	СтратегияПредохранителя = Новый СтратегияПредохранителя(1, 100);
	Пайплайн = Новый ПайплайнОтказоустойчивости()
		.ДобавитьСтратегию(СтратегияПредохранителя)
		.ДобавитьТаймаут(20);

	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	Сценарий.УстановитьЗадержку(300);
	Операция = Новый Действие(Сценарий, "Долгое");

	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();

	// Действие и Проверка
	Ожидаем
		.Что(Пайплайн, "Вызов пайплайна должен выбрасывать ожидаемое исключение")
		.Метод(
			"Запустить",
			ПомощникТестирования.ПараметрыИсполнения(Операция, Неопределено, СигналПрерыванияОперации)
		)
		.ВыбрасываетИсключение("Превышен таймаут выполнения");

	Ожидаем.Что(СигналПрерыванияОперации.ПрерываниеЗапрошено(), "Прерывание должно быть запрошено").ЭтоИстина();
	Ожидаем
		.Что(СтратегияПредохранителя.Состояние(), "Состояние предохранителя должно перейти в разомкнутое")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем.Что(СтратегияПредохранителя.КоличествоОшибокПодряд(), "Количество ошибок подряд должно стать равным 1").Равно(1);
	Ожидаем.Что(Сценарий.СчетчикВызовов(), "Пользовательская операция должна быть запущена один раз").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершатьТестовуюФикстуруПоТаймаутуЕслиНетРазрешения() Экспорт

	// Подготовка
	Сценарий = Новый ТестовоеУправляемоеДействие();

	Задача = ФоновыеЗадания.Выполнить(
		Сценарий,
		"ВыполнитьУправляемо"
	);

	ДействиеНачалось = ДождатьсяНачалаДействия(Сценарий);

	// Действие
	ЗавершиласьДоПринудительногоРазрешения = Задача.ОжидатьЗавершения(1500);

	Если Не ЗавершиласьДоПринудительногоРазрешения Тогда
		Сценарий.Разрешить();
		Задача.ОжидатьЗавершения(5000);
	КонецЕсли;

	// Проверка
	Ожидаем.Что(ДействиеНачалось, "Управляемое действие должно начаться").ЭтоИстина();
	Ожидаем
		.Что(
			ЗавершиласьДоПринудительногоРазрешения,
			"Управляемое действие должно завершиться собственным таймаутом без внешнего разрешения"
		)
		.ЭтоИстина();
	Ожидаем.Что(Задача.ИнформацияОбОшибке <> Неопределено, "Завершение по таймауту должно быть ошибкой").ЭтоИстина();
	Ожидаем
		.Что(КраткоеПредставлениеОшибки(Задача.ИнформацияОбОшибке), "Текст ошибки должен описывать таймаут")
		.Содержит("Управляемое действие не получило разрешение");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОсвобождатьПробныйВызовЕслиПрерываниеЗапрошеноВПолуразомкнутомСостоянии() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 100);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");

	СигналПрерыванияОперации = Новый СигналПрерыванияОперации();
	СигналПрерыванияОперации.ЗапроситьПрерывание("Остановлено тестом.");

	Ожидаем
		.Что(Стратегия, "Первый сбой должен разомкнуть предохранитель")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);

	// Действие
	Ожидаем
		.Что(Стратегия, "Прерванный пробный вызов должен завершиться причиной прерывания")
		.Метод(
			"Применить",
			ПомощникТестирования.ПараметрыИсполнения(ОперацияУспеха, Неопределено, СигналПрерыванияОперации)
		)
		.ВыбрасываетИсключение("Остановлено тестом.");

	Результат = Стратегия.Применить(ОперацияУспеха);

	// Проверка
	Ожидаем.Что(Результат, "Следующий пробный вызов должен быть разрешен").Равно("ok");
	Ожидаем.Что(СценарийУспеха.СчетчикВызовов(), "Должен выполниться только успешный непрерванный вызов").Равно(1);
	Ожидаем.Что(Стратегия.Состояние(), "Успешная проба должна закрыть предохранитель")
		.Равно(СостоянияПредохранителя.Закрыт);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗакрыватьРазомкнутыйПредохранительПозднимУспехомПараллельногоВызова() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 500);

	СценарийМедленногоУспеха = Новый ТестовоеУправляемоеДействие();
	ОперацияМедленногоУспеха = Новый Действие(СценарийМедленногоУспеха, "ВыполнитьУправляемо");

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	ЗадачаУспеха = ФоновыеЗадания.Выполнить(
		Стратегия,
		"Применить",
		ПомощникТестирования.ПараметрыИсполнения(ОперацияМедленногоУспеха)
	);

	НачалсяМедленныйВызов = ДождатьсяНачалаДействия(СценарийМедленногоУспеха);

	// Действие
	Ожидаем
		.Что(Стратегия, "Параллельная ошибка должна разомкнуть предохранитель")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	СостояниеПослеОшибки = Стратегия.Состояние();
	СценарийМедленногоУспеха.Разрешить();

	// Проверка
	Ожидаем.Что(НачалсяМедленныйВызов, "Медленный вызов должен уже выполняться").ЭтоИстина();
	Ожидаем.Что(ЗадачаУспеха.ОжидатьЗавершения(5000), "Медленный вызов должен завершиться").ЭтоИстина();
	Ожидаем.Что(ЗадачаУспеха.ИнформацияОбОшибке = Неопределено, "Медленный вызов должен завершиться успешно").ЭтоИстина();
	Ожидаем.Что(СостояниеПослеОшибки, "Ошибка должна разомкнуть предохранитель")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем.Что(Стратегия.Состояние(), "Поздний успех не должен закрывать уже разомкнутый предохранитель")
		.Равно(СостоянияПредохранителя.Разомкнут);

