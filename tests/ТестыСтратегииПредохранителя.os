&Тест
Процедура ТестДолжен_ВызыватьОбработчикРазмыканияПриНеудачнойПробнойПопытке() Экспорт

	// Подготовка
	Колбэки = Новый ТестовыеКолбэкиПредохранителя();

	Стратегия = Новый СтратегияПредохранителя(1, 100);
	Стратегия.УстановитьОбработчикРазмыкания(Новый Действие(Колбэки, "ПослеРазмыкания"));

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	// Действие
	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);

	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Полуразомкнут);

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	// Проверка
	Ожидаем.Что(Колбэки.ПорогиОшибок().Количество(), "Количество порогов ошибок должно быть равно 2").Равно(2);
	Ожидаем.Что(Колбэки.ПорогиОшибок()[0], "Порог ошибок должен быть равен 1").Равно(1);
	Ожидаем.Что(Колбэки.ПорогиОшибок()[1], "Порог ошибок должен быть равен 1").Равно(1);
	Ожидаем.Что(Колбэки.КоличествоОшибокПодряд()[0], "Количество ошибок подряд должно быть равно 1").Равно(1);
	Ожидаем.Что(Колбэки.КоличествоОшибокПодряд()[1], "Количество ошибок подряд должно быть равно 1").Равно(1);
	Ожидаем.Что(Колбэки.ДлительностиРазмыкания()[0], "Длительность размыкания должна быть равна 100").Равно(100);
	Ожидаем.Что(Колбэки.ДлительностиРазмыкания()[1], "Длительность размыкания должна быть равна 100").Равно(100);
	Ожидаем
		.Что(Колбэки.Состояния()[0], "Значение должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем
		.Что(Колбэки.Состояния()[1], "Значение должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);
	Ожидаем.Что(Колбэки.ЕстьДанныеОшибки()[0], "Признак наличия данных об ошибке должен быть истинным").ЭтоИстина();
	Ожидаем.Что(Колбэки.ЕстьДанныеОшибки()[1], "Признак наличия данных об ошибке должен быть истинным").ЭтоИстина();
	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Разомкнут);

КонецПроцедуры

