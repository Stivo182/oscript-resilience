	Ожидаем.Что(ПробнаяОшибкаНачалась, "Пробный вызов должен начаться").ЭтоИстина();
	Ожидаем.Что(ПробнаяОшибкаЗавершилась, "Пробный вызов должен завершиться").ЭтоИстина();
	Ожидаем.Что(ЗадачаПробнойОшибки.ИнформацияОбОшибке <> Неопределено, "Пробный вызов должен завершиться ошибкой").ЭтоИстина();
	Ожидаем.Что(Стратегия.Состояние(), "Устаревшая пробная ошибка не должна размыкать предохранитель после сброса")
		.Равно(СостоянияПредохранителя.Закрыт);
	Ожидаем.Что(Стратегия.КоличествоОшибокПодряд(), "Устаревшая пробная ошибка не должна увеличивать счетчик ошибок").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьУспехУстаревшегоПробногоВызоваВНовомПолуразомкнутомСостоянии() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 200);

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийПробногоУспеха = Новый ТестовоеУправляемоеДействие();
	ОперацияПробногоУспеха = Новый Действие(СценарийПробногоУспеха, "ВыполнитьУправляемо");

	// Действие
	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Первый сбой должен разомкнуть предохранитель"
	);

	ЗадачаПробногоУспеха = ЗапуститьПробныйВызовВФоне(Стратегия, ОперацияПробногоУспеха);

	ПробныйУспехНачался = ДождатьсяНачалаДействия(СценарийПробногоУспеха);

	Стратегия.Сбросить();

	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Новая ошибка после сброса должна снова разомкнуть предохранитель"
	);

	СценарийПробногоУспеха.Разрешить();
	ПробныйУспехЗавершился = ЗадачаПробногоУспеха.ОжидатьЗавершения(5000);

	// Проверка
	Ожидаем.Что(ПробныйУспехНачался, "Пробный вызов должен начаться").ЭтоИстина();
	Ожидаем.Что(ПробныйУспехЗавершился, "Пробный вызов должен завершиться").ЭтоИстина();
	Ожидаем.Что(ЗадачаПробногоУспеха.ИнформацияОбОшибке = Неопределено, "Пробный вызов должен завершиться успешно").ЭтоИстина();
	Ожидаем.Что(Стратегия.Состояние(), "Устаревший пробный успех не должен закрывать новое полуразомкнутое состояние")
		.Равно(СостоянияПредохранителя.Полуразомкнут);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИгнорироватьОшибкуУстаревшегоПробногоВызоваВНовомПолуразомкнутомСостоянии() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 200);

	Колбэки = Новый ТестовыеКолбэкиПредохранителя();
	Стратегия.УстановитьОбработчикРазмыкания(Новый Действие(Колбэки, "ПослеРазмыкания"));

	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");

	СценарийПробнойОшибки = Новый ТестовоеУправляемоеДействие();
	ОперацияПробнойОшибки = Новый Действие(СценарийПробнойОшибки, "ВыполнитьУправляемоСОшибкой");

	// Действие
	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Первый сбой должен разомкнуть предохранитель"
	);

	ЗадачаПробнойОшибки = ЗапуститьПробныйВызовВФоне(Стратегия, ОперацияПробнойОшибки);

	ПробнаяОшибкаНачалась = ДождатьсяНачалаДействия(СценарийПробнойОшибки);

	Стратегия.Сбросить();

	РазомкнутьИДождатьсяПолуразомкнутогоСостояния(
		Стратегия,
		ОперацияОшибки,
		"Новая ошибка после сброса должна снова разомкнуть предохранитель"
	);

	КоличествоРазмыканийДоУстаревшейОшибки = Колбэки.ПорогиОшибок().Количество();
	СценарийПробнойОшибки.Разрешить();
	ПробнаяОшибкаЗавершилась = ЗадачаПробнойОшибки.ОжидатьЗавершения(5000);

	// Проверка
	Ожидаем.Что(ПробнаяОшибкаНачалась, "Пробный вызов должен начаться").ЭтоИстина();
	Ожидаем.Что(ПробнаяОшибкаЗавершилась, "Пробный вызов должен завершиться").ЭтоИстина();
	Ожидаем.Что(ЗадачаПробнойОшибки.ИнформацияОбОшибке <> Неопределено, "Пробный вызов должен завершиться ошибкой").ЭтоИстина();
	Ожидаем.Что(КоличествоРазмыканийДоУстаревшейОшибки, "Первые две ошибки должны вызвать два размыкания").Равно(2);
	Ожидаем.Что(Колбэки.ПорогиОшибок().Количество(), "Устаревшая пробная ошибка не должна вызывать новое размыкание")
		.Равно(КоличествоРазмыканийДоУстаревшейОшибки);
	Ожидаем.Что(Стратегия.Состояние(), "Устаревшая пробная ошибка не должна размыкать новое полуразомкнутое состояние")
		.Равно(СостоянияПредохранителя.Полуразомкнут);

КонецПроцедуры

// Флаки-тест
&Тест
Процедура ТестДолжен_РазрешатьТолькоОднуПробнуюПопыткуПриПараллельныхВызовах() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияПредохранителя(1, 100);
	
	СценарийОшибки = Новый ТестовыеДействияОтказоустойчивости();
	ОперацияОшибки = Новый Действие(СценарийОшибки, "ВсегдаОшибка");
	
	СценарийУспеха = Новый ТестовыеДействияОтказоустойчивости();
	СценарийУспеха.УстановитьЗадержку(200);
	ОперацияУспеха = Новый Действие(СценарийУспеха, "Успех");
	
	КоличествоПараллельныхЗадач = 10;

	Ожидаем
		.Что(Стратегия, "Вызов метода стратегии должен выбрасывать ожидаемое исключение")
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);
	
	// Действие
	Задачи = ПомощникТестирования.ЗапуститьПараллельныеВызовыСтратегии(
		Стратегия,
		ОперацияУспеха,
		КоличествоПараллельныхЗадач
	);

	Статистика = СобратьСтатистикуФоновыхЗаданий(Задачи, "Пробный вызов уже выполняется");

	// Проверка
	Ожидаем.Что(Статистика.Успешных, "Количество успешных вызовов должно быть равно 1").Равно(1);
	Ожидаем
		.Что(Статистика.ОжидаемыхОшибок, "Количество ожидаемых ошибок должно быть равно ожидаемому значению")
		.Равно(КоличествоПараллельныхЗадач - 1);
	Ожидаем.Что(Статистика.НеожиданныеОшибки.Количество(), "Количество неожиданных ошибок должно быть равно 0").Равно(0);
	Ожидаем.Что(СценарийУспеха.СчетчикВызовов(), "Счетчик вызовов должен быть равен 1").Равно(1);
	Ожидаем
		.Что(Стратегия.Состояние(), "Состояние должно быть равно ожидаемому значению")
		.Равно(СостоянияПредохранителя.Закрыт);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДождатьсяНачалаДействия(Действие, Таймаут = 1000)

	МоментНачалаОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачалаОжидания < Таймаут Цикл
		Если Действие.Начато() Тогда
			Возврат Истина;
		КонецЕсли;

		Приостановить(10);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура РазомкнутьИДождатьсяПолуразомкнутогоСостояния(Стратегия, ОперацияОшибки, ОписаниеОшибки)

	РазомкнутьПредохранительОшибкой(Стратегия, ОперацияОшибки, ОписаниеОшибки);
	ДождатьсяСостоянияПредохранителя(Стратегия, СостоянияПредохранителя.Полуразомкнут);

КонецПроцедуры

Процедура РазомкнутьПредохранительОшибкой(Стратегия, ОперацияОшибки, ОписаниеОшибки)

	Ожидаем
		.Что(Стратегия, ОписаниеОшибки)
		.Метод("Применить", ПомощникТестирования.ПараметрыИсполнения(ОперацияОшибки))
		.ВыбрасываетИсключение("Всегда ошибка.");

КонецПроцедуры

Функция ЗапуститьПробныйВызовВФоне(Стратегия, ОперацияПробногоВызова)

	Возврат ФоновыеЗадания.Выполнить(
		Стратегия,
		"Применить",
		ПомощникТестирования.ПараметрыИсполнения(ОперацияПробногоВызова)
	);

КонецФункции

Процедура ДождатьсяСостоянияПредохранителя(Стратегия, ОжидаемоеСостояние, Таймаут = 1000)

	МоментНачалаОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачалаОжидания < Таймаут Цикл
		Если Стратегия.Состояние() = ОжидаемоеСостояние Тогда
			Возврат;
		КонецЕсли;

		Приостановить(10);
	КонецЦикла;

	Ожидаем.Что(Стратегия.Состояние(), "Предохранитель должен перейти в ожидаемое состояние").Равно(ОжидаемоеСостояние);

КонецПроцедуры

Функция СобратьСтатистикуФоновыхЗаданий(Задачи, ОжидаемыйТекстОшибки)

	Статистика = Новый Структура("Успешных, ОжидаемыхОшибок, НеожиданныеОшибки", 0, 0, Новый Массив());

	Для Каждого Задание Из Задачи Цикл
		Если Не Задание.ОжидатьЗавершения(5000) Тогда
			ВызватьИсключение "Фоновое задание не завершилось вовремя.";
		КонецЕсли;

		Если Задание.ИнформацияОбОшибке = Неопределено Тогда
			Статистика.Успешных = Статистика.Успешных + 1;
			Продолжить;
		КонецЕсли;

		ТекстОшибки = ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
		
		Если СтрНайти(ТекстОшибки, ОжидаемыйТекстОшибки) > 0 Тогда
			Статистика.ОжидаемыхОшибок = Статистика.ОжидаемыхОшибок + 1;
		Иначе
			Статистика.НеожиданныеОшибки.Добавить(ТекстОшибки);
		КонецЕсли;
	КонецЦикла;

	Возврат Статистика;

КонецФункции

#КонецОбласти
