&Тест
Процедура ТестДолжен_КлассифицироватьОтклонениеПоОграничениюПараллелизма() Экспорт

	// Подготовка
	Стратегия = Новый СтратегияОграниченияПараллелизма(1);
	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	ВложеннаяОперация = Новый Действие(Сценарий, "Успех");
	ДействиеСВложеннымВызовом = Новый ТестовоеДействиеСВложеннымВызовомОграниченияПараллелизма(
		Стратегия,
		ВложеннаяОперация
	);
	Операция = Новый Действие(ДействиеСВложеннымВызовом, "ВыполнитьСВложеннымЗапуском");

	// Действие
	Стратегия.Применить(Операция);

	// Проверка
	ПроверитьКодОшибки(
		ДействиеСВложеннымВызовом.ИнформацияОВнутреннейОшибке(),
		КодыОшибокОтказоустойчивости.ОтклонениеПоОграничениюПараллелизма()
	);
	ПроверитьОтсутствиеДанныхОшибки(ДействиеСВложеннымВызовом.ИнформацияОВнутреннейОшибке());

КонецПроцедуры

&Тест
Процедура ТестДолжен_КлассифицироватьРазомкнутыйПредохранитель() Экспорт

	// Подготовка
	Сценарий = Новый ТестовыеДействияОтказоустойчивости();
	ОшибкаОперации = Новый Действие(Сценарий, "ВсегдаОшибка");
	УспешнаяОперация = Новый Действие(Сценарий, "Успех");
	Стратегия = Новый СтратегияПредохранителя(1, 1000);

	Попытка
		Стратегия.Применить(ОшибкаОперации);
	Исключение
	КонецПопытки;

	// Действие
	Ошибка = Неопределено;
	Попытка
		Стратегия.Применить(УспешнаяОперация);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	ПроверитьКодОшибки(Ошибка, КодыОшибокОтказоустойчивости.РазомкнутыйПредохранитель());
	ПроверитьОтсутствиеДанныхОшибки(Ошибка);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранятьКодОшибкиПользовательскойОперацииПослеФоновогоЗапуска() Экспорт

	// Подготовка
	КорневаяОшибка = ФабрикаОшибок.Создать("test.root.failed", "Корневая ошибка");
	ИсходнаяОшибка = ФабрикаОшибок.Создать(
		"test.operation.failed",
		"Ошибка пользовательской операции",
		Неопределено,
		КорневаяОшибка
	);
	Сценарий = Новый ТестоваяСтруктурированнаяОшибка(ИсходнаяОшибка);
	Операция = Новый Действие(Сценарий, "ВызватьОшибку");
	Стратегия = Новый СтратегияТаймаута(1000);

	// Действие
	Ошибка = Неопределено;
	Попытка
		Стратегия.Применить(Операция);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	РазборОшибки = ДиагностикаОшибок.Разобрать(Ошибка);
	Ожидаем.Что(РазборОшибки.КодОшибки()).Равно("test.operation.failed");
	Ожидаем.Что(РазборОшибки.ЭффективнаяОшибка().Сообщение()).Равно("Ошибка пользовательской операции");
	Ожидаем.Что(РазборОшибки.КорневаяПричина().КодОшибки()).Равно("test.root.failed");

КонецПроцедуры

Процедура ПроверитьОтсутствиеДанныхОшибки(Ошибка)

	ДанныеОшибки = ДиагностикаОшибок.Разобрать(Ошибка).Данные();
	Ожидаем.Что(ДанныеОшибки, "Предметная ошибка не должна дублировать контекст").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКодОшибки(Ошибка, ОжидаемыйКод)

	Ожидаем.Что(Ошибка <> Неопределено, "Ожидалось исключение").ЭтоИстина();
	КодОшибки = ДиагностикаОшибок.Разобрать(Ошибка).КодОшибки();
	Ожидаем
		.Что(
			КодОшибки,
			"Код ошибки должен совпадать с ожидаемым. Получена ошибка: " + КраткоеПредставлениеОшибки(Ошибка)
		)
		.Равно(ОжидаемыйКод);

КонецПроцедуры

#КонецОбласти
